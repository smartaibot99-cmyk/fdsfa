    <FarmCard
      key={farm.id}
      farm={farm}
      selected={farm.id === selectedFarmId}
      onClick={() => selectFarm(farm.id)}
    />
  ))}
</div>
```

CSS:

```css
.farm-list-scroll {
  flex: 1;
  min-height: 0;

