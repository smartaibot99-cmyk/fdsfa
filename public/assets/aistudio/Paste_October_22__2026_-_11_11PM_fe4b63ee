    textColor: 'text-amber-300',
    bgColor: 'bg-amber-500/20',
    borderColor: 'border-amber-400/50',
    dotColor: '#F59E0B',
    gradient: 'from-amber-600/30 to-amber-900/30',
  },
  chickpea: {
    name: 'Chickpea',
    textColor: 'text-emerald-300',
    bgColor: 'bg-emerald-500/20',
    borderColor: 'border-emerald-400/50',
    dotColor: '#10B981',
    gradient: 'from-emerald-600/30 to-emerald-900/30',
  },
  lentil: {
    name: 'Lentil',
    textColor: 'text-sky-300',
    bgColor: 'bg-sky-500/20',
    borderColor: 'border-sky-400/50',
    dotColor: '#0EA5E9',
    gradient: 'from-sky-600/30 to-sky-900/30',
  },
  sorghum: {
    name: 'Grain Sorghum',
    textColor: 'text-purple-300',
    bgColor: 'bg-purple-500/20',
    borderColor: 'border-purple-400/50',
    dotColor: '#A855F7',
    gradient: 'from-purple-600/30 to-purple-900/30',
  },
  cover_crop: {
    name: 'Cover Crop',
    textColor: 'text-teal-300',
    bgColor: 'bg-teal-500/20',
    borderColor: 'border-teal-400/50',
    dotColor: '#14B8A6',
    gradient: 'from-teal-600/30 to-teal-900/30',
  },
  fallow: {
    name: 'Fallow',
    textColor: 'text-slate-300',
    bgColor: 'bg-slate-500/20',
    borderColor: 'border-slate-400/50',
    dotColor: '#94A3B8',
    gradient: 'from-slate-600/30 to-slate-900/30',
  },
};

// Farm specific distinct accent hues for multi-farm representation
const FARM_BADGE_COLORS: Record<string, { bg: string; border: string; text: string }> = {
  farm_marjan_01: { bg: 'bg-[#27D7B2]/20', border: 'border-[#27D7B2]/60', text: 'text-[#27D7B2]' },
  farm_rak_02: { bg: 'bg-indigo-500/25', border: 'border-indigo-400/60', text: 'text-indigo-300' },
};

export const CropCalendarView: React.FC<CropCalendarViewProps> = ({
  activeFarm,
  allFarms = [],
  analysis,
  onNavigateTab,
  onOpenFarmDetail,
  onOpenCropRotation,
  onOpenGuide,
}) => {
  // Calendar month state: Default to October 2026
  const [currentDate, setCurrentDate] = useState(() => new Date(2026, 9, 1)); // Oct 2026
  const [selectedDayNumber, setSelectedDayNumber] = useState<number>(14); // Selected day default Oct 14

  const farmName = activeFarm?.name || 'Al Marjan Farm';
  const locationName = activeFarm?.locationName || activeFarm?.farmAnswers?.locationName || 'Ras Al Khaimah, UAE';

  const monthNames = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
