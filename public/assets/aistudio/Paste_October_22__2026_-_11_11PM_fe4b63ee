          const isActive = farm.id === activeFarmId;
          const topRotation = farm.analysis?.rotations?.[0];
          const updatedDate = new Date(farm.updatedAt).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });

          return (
            <div
              key={farm.id}
              onClick={() => {
                if (editingId !== farm.id) {
                  onSelectFarm(farm.id);
                  onClose();
