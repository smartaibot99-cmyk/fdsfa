import React, { useState } from 'react';
import {
  Bell,
  AlertTriangle,
  CheckCheck,
  X,
  Droplets,
  Sun,
  CloudRain,
  ChevronRight,
  ExternalLink,
  ShieldAlert,
} from 'lucide-react';
import { NasaAlert } from '../../types';

interface NotificationsDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  alerts: NasaAlert[];
  onMarkAllAsRead: () => void;
  onSelectFarmAlert: (farmId: string) => void;
  onDismissAlert?: (alertId: string) => void;
  isAdvanced?: boolean;
}

export const NotificationsDrawer: React.FC<NotificationsDrawerProps> = ({
  isOpen,
  onClose,
  alerts,
  onMarkAllAsRead,
  onSelectFarmAlert,
  onDismissAlert,
  isAdvanced = false,
}) => {
  const [filterSeverity, setFilterSeverity] = useState<'all' | 'critical'>('all');

  if (!isOpen) return null;

  const filteredAlerts =
    filterSeverity === 'critical'
      ? alerts.filter((a) => a.severity === 'critical')
      : alerts;

  const unreadCount = alerts.filter((a) => !a.read).length;

  return (
    <aside
      aria-label="Environmental Notifications Panel"
      className="fixed right-0 top-[60px] bottom-0 w-[380px] sm:w-[420px] max-w-[90vw] z-40 backdrop-blur-xl border-l shadow-[-16px_0_40px_rgba(0,0,0,0.65)] flex flex-col animate-in slide-in-from-right duration-250"
      style={{
        backgroundColor: 'var(--card-bg, rgba(3, 25, 35, 0.95))',
        borderLeftColor: 'var(--card-border, rgba(39, 215, 178, 0.4))',
      }}
    >
      {/* Drawer Header */}
      <div
        className="p-4 sm:p-5 border-b flex items-center justify-between shrink-0"
        style={{
          backgroundColor: 'var(--bg-surface, rgba(4, 29, 42, 0.8))',
          borderBottomColor: 'var(--card-border, rgba(39, 215, 178, 0.2))',
        }}
      >
        <div className="flex items-center gap-2.5">
          <div className="w-8 h-8 rounded-lg bg-[#27D7B2]/15 border border-[#27D7B2]/30 flex items-center justify-center text-[#27D7B2]">
            <Bell className="w-4 h-4" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-sm font-bold text-white tracking-tight">
                NASA Observations
              </h2>
              {unreadCount > 0 && (
                <span className="px-1.5 py-0.5 rounded-full bg-amber-400 text-[#031923] text-[10px] font-bold">
                  {unreadCount} new
                </span>
              )}
            </div>
            <p className="text-[11px] text-[#8DA4B4] leading-tight mt-0.5">
              Live orbital telemetry alerts
            </p>
          </div>
        </div>

        {/* Action icons: Mark as read + Close */}
        <div className="flex items-center gap-1">
          {unreadCount > 0 && (
            <button
              type="button"
              onClick={onMarkAllAsRead}
              className="p-1.5 text-[#8DA4B4] hover:text-[#27D7B2] rounded-lg transition-colors cursor-pointer text-xs"
              title="Mark all as read"
            >
              <CheckCheck className="w-4 h-4" />
            </button>
          )}
          <button
            type="button"
            onClick={onClose}
            className="p-1.5 text-[#8DA4B4] hover:text-white rounded-lg transition-colors cursor-pointer"
            aria-label="Close notifications panel"
          >
            <X className="w-4 h-4" />
          </button>
        </div>
      </div>

      {/* Filter Tabs */}
      <div className="px-4 py-2 border-b border-[#27D7B2]/15 flex items-center justify-between bg-[#031520]/60 text-xs">
        <div className="flex items-center gap-1.5">
          <button
            type="button"
            onClick={() => setFilterSeverity('all')}
            className={`px-2.5 py-1 rounded-[6px] transition-colors cursor-pointer text-[11px] font-medium ${
              filterSeverity === 'all'
                ? 'bg-[#27D7B2]/20 text-[#27D7B2] border border-[#27D7B2]/40'
                : 'text-[#8DA4B4] hover:text-white'
            }`}
          >
            All Alerts ({alerts.length})
          </button>
          <button
            type="button"
            onClick={() => setFilterSeverity('critical')}
            className={`px-2.5 py-1 rounded-[6px] transition-colors cursor-pointer text-[11px] font-medium ${
              filterSeverity === 'critical'
                ? 'bg-amber-400/20 text-amber-300 border border-amber-400/40'
                : 'text-[#8DA4B4] hover:text-white'
            }`}
          >
            Critical Only
          </button>
        </div>
        <span className="text-[10px] text-[#718D9A] font-mono">
          Non-blocking panel
        </span>
      </div>

