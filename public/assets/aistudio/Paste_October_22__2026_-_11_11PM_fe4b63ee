  const handleNextMonth = () => {
    setCurrentDate(new Date(currentYear, currentMonth + 1, 1));
  };

  const handleResetToday = () => {
    setCurrentDate(new Date(2026, 9, 1));
    setSelectedDayNumber(14);
  };

  /**
   * Evaluates what crops are growing across all saved farms for any given date.
   * If two farms grow crops at the same date, both are returned with distinct farm associations and colors!
   */
  const getCropsForDateAcrossFarms = (year: number, month: number, day: number) => {
    const list: Array<{
      key: string;
      name: string;
      stage: string;
      farmId: string;
      farmName: string;
    }> = [];

    const effectiveFarms = allFarms.length > 0 ? allFarms : activeFarm ? [activeFarm] : [];

    effectiveFarms.forEach((f, fIdx) => {
      let cropKey: string | null = null;
      let cropName: string = '';
      let stage: string = 'Growing';

      // Farm 1: Wheat (Oct-Feb), Chickpea (Mar-May), Lentil (Jun-Aug), Sorghum (Sep-Dec)
      if (fIdx === 0) {
        if (year === 2026 && month === 9) {
          if (day >= 10) {
            cropKey = 'wheat';
            cropName = 'Wheat';
            stage = day <= 24 ? 'Sowing' : 'Growing';
          }
        } else if ((year === 2026 && month > 9) || (year === 2027 && month <= 1)) {
          cropKey = 'wheat';
          cropName = 'Wheat';
          stage = 'Growing';
        } else if (year === 2027 && month >= 2 && month <= 4) {
          cropKey = 'chickpea';
          cropName = 'Chickpea';
          stage = 'Growing';
        } else if (year === 2027 && month >= 5 && month <= 7) {
          cropKey = 'lentil';
          cropName = 'Lentil';
          stage = 'Growing';
        } else if (year === 2027 && month >= 8 && month <= 11) {
          cropKey = 'sorghum';
          cropName = 'Grain Sorghum';
          stage = 'Growing';
        }
      } else {
        // Farm 2: Also Wheat in Autumn/Winter, Chickpea in Spring, Cover Crop in Summer
        if (year === 2026 && month === 9) {
          if (day >= 12) {
            cropKey = 'wheat';
            cropName = 'Wheat';
            stage = 'Sowing';
          }
        } else if ((year === 2026 && month > 9) || (year === 2027 && month <= 1)) {
          cropKey = 'wheat';
          cropName = 'Wheat';
          stage = 'Growing';
        } else if (year === 2027 && month >= 2 && month <= 4) {
          cropKey = 'chickpea';
          cropName = 'Chickpea';
          stage = 'Growing';
        } else if (year === 2027 && month >= 5 && month <= 7) {
          cropKey = 'cover_crop';
          cropName = 'Cover Crop';
          stage = 'Soil Building';
        }
      }

      if (cropKey) {
        list.push({
          key: cropKey,
          name: cropName,
          stage,
          farmId: f.id,
          farmName: f.name,
        });
      }
    });

    return list;
  };

  // Generate 42 calendar grid cells (Monday first)
  const calendarDays = useMemo(() => {
    const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay(); // 0 is Sun
    const adjustedFirstDay = (firstDayIndex + 6) % 7; // Monday = 0
    const totalDaysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();

    const days = [];

    // Prev month padding
    for (let i = adjustedFirstDay - 1; i >= 0; i--) {
      days.push({
        dayNumber: daysInPrevMonth - i,
        month: currentMonth - 1,
        year: currentYear,
        isCurrentMonth: false,
      });
    }

    // Current month days
    for (let d = 1; d <= totalDaysInMonth; d++) {
      days.push({
        dayNumber: d,
        month: currentMonth,
        year: currentYear,
        isCurrentMonth: true,
      });
    }

    // Next month padding
    const remaining = (7 - (days.length % 7)) % 7;
    for (let n = 1; n <= remaining; n++) {
      days.push({
        dayNumber: n,
        month: currentMonth + 1,
        year: currentYear,
        isCurrentMonth: false,
      });
    }

    return days;
  }, [currentYear, currentMonth]);

  // Selected date status
  const selectedCropsList = getCropsForDateAcrossFarms(currentYear, currentMonth, selectedDayNumber);

  const handleCropNameClick = (cropName: string, farmId: string) => {
    if (onOpenCropRotation) {
      onOpenCropRotation(farmId, cropName);
    } else if (onOpenFarmDetail) {
      onOpenFarmDetail(farmId, 'rotations', cropName);
    } else if (onNavigateTab) {
      onNavigateTab('rotations');
    }
  };

  return (
    <div className="w-full min-h-[calc(100vh-60px)] px-4 sm:px-6 lg:px-10 py-6 max-w-[1440px] mx-auto space-y-6">
      {/* Top Header Strip */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/[0.08]">
        <div>
          <h1 className="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Crop Planting Calendar
          </h1>
          <p className="text-xs text-[#A7C0CC] mt-0.5">
            Active Farm: <strong className="text-white">{farmName}</strong> ({locationName}) · Tracking plantings across all fields
          </p>
        </div>

        {onOpenGuide && (
          <button
            type="button"
            onClick={onOpenGuide}
            className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-[#27D7B2] hover:text-white text-xs font-semibold border border-white/[0.08] transition-all cursor-pointer self-start sm:self-auto"
            title="Calendar Guide"
          >
            <HelpCircle className="w-3.5 h-3.5 text-[#27D7B2]" />
            <span>Guide</span>
          </button>
        )}
      </div>

      {/* Main Full-Width Responsive Two-Column Layout (Expanded to fill available space) */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        {/* =================================================================== */}
        {/* EXPANDED FULL-SCREEN CALENDAR CARD (Fits Screen Gracefully)          */}
        {/* =================================================================== */}
        <div className="lg:col-span-8 w-full rounded-2xl bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] p-5 sm:p-6 space-y-4 text-[#F0F7FA]">
          {/* 1. Month Header with FIXED Arrow Positions (Arrows NEVER move) */}
          <div className="w-full flex items-center justify-between relative px-2">
            {/* Left Prev Arrow Button (Fixed at far left) */}
            <button
              type="button"
              onClick={handlePrevMonth}
              className="w-9 h-9 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 border border-white/[0.08]"
              title="Previous Month"
              aria-label="Previous Month"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>

            {/* Centered Month Year Text with fixed container so arrow locations NEVER shift */}
            <div className="w-56 text-center shrink-0">
              <h2 className="text-lg sm:text-xl font-bold text-white tracking-tight select-none">
                {monthNames[currentMonth]} {currentYear}
              </h2>
            </div>

            {/* Right Next Arrow Button (Fixed at far right) */}
            <button
              type="button"
              onClick={handleNextMonth}
              className="w-9 h-9 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 border border-white/[0.08]"
              title="Next Month"
              aria-label="Next Month"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>

          {/* Thin Divider */}
          <div className="w-full h-px bg-white/[0.08]" />

          {/* 2. Days of Week Row (Mo, Tu, We, Th, Fr, Sa, Su) */}
          <div className="grid grid-cols-7 gap-2 text-center text-xs font-bold text-[#A7C0CC] pb-1 uppercase tracking-wider">
            <div>Mo</div>
            <div>Tu</div>
            <div>We</div>
            <div>Th</div>
            <div>Fr</div>
            <div>Sa</div>
            <div>Su</div>
          </div>

          {/* 3. Stretched, High-Legibility Calendar Grid */}
          <div className="grid grid-cols-7 gap-2">
            {calendarDays.map((cell, idx) => {
              const crops = cell.isCurrentMonth
                ? getCropsForDateAcrossFarms(cell.year, cell.month, cell.dayNumber)
                : [];
              const isSelected = cell.isCurrentMonth && cell.dayNumber === selectedDayNumber;
              const hasMultipleFarms = crops.length > 1;

              // Primary crop config for single crop or first crop
              const firstCrop = crops[0];
              const firstCropConfig = firstCrop ? CROP_COLORS[firstCrop.key] : null;

              return (
                <button
                  key={`${cell.year}-${cell.month}-${cell.dayNumber}-${idx}`}
                  type="button"
                  disabled={!cell.isCurrentMonth}
                  onClick={() => {
                    if (cell.isCurrentMonth) {
                      setSelectedDayNumber(cell.dayNumber);
                    }
                  }}
                  className={`min-h-[64px] sm:min-h-[72px] w-full rounded-xl flex flex-col items-center justify-between p-1.5 transition-all relative overflow-hidden ${
                    cell.isCurrentMonth
                      ? isSelected
                        ? 'bg-cyan-500/20 border-2 border-cyan-400 text-white shadow-md ring-1 ring-cyan-400/50'
                        : hasMultipleFarms
                        ? 'bg-gradient-to-br from-amber-500/25 via-[#031D29] to-indigo-500/25 border border-white/20 text-white hover:brightness-110'
                        : firstCropConfig
                        ? `${firstCropConfig.bgColor} ${firstCropConfig.borderColor} border ${firstCropConfig.textColor} hover:brightness-110`
                        : 'bg-white/[0.02] border border-white/[0.06] text-slate-300 hover:bg-white/[0.06]'
                      : 'opacity-25 text-slate-600 border border-transparent cursor-default'
                  }`}
                >
                  {/* Day Number */}
                  <div className="w-full flex items-center justify-between">
                    <span className={`text-xs font-bold font-mono ${isSelected ? 'text-[#27D7B2] font-black' : 'text-white'}`}>
                      {cell.dayNumber}
                    </span>

                    {/* Multi-farm indicator dots */}
                    {crops.length > 1 && (
                      <div className="flex items-center gap-1">
                        <span className="w-1.5 h-1.5 rounded-full bg-[#27D7B2]" title="Al Marjan Farm" />
                        <span className="w-1.5 h-1.5 rounded-full bg-indigo-400" title="RAK Farm" />
                      </div>
                    )}
                  </div>

                  {/* Plant Name through text in each day box */}
                  <div className="w-full flex flex-col gap-0.5 items-center">
                    {crops.map((cr, cIdx) => (
                      <span
                        key={cIdx}
                        onClick={(e) => {
                          e.stopPropagation();
                          handleCropNameClick(cr.name, cr.farmId);
                        }}
                        className="text-[10px] sm:text-xs font-bold leading-tight truncate max-w-full text-center px-1 rounded bg-black/50 hover:bg-[#27D7B2] hover:text-[#020A10] transition-colors cursor-pointer"
                        title={`Click to view ${cr.farmName}'s rotation details for ${cr.name}`}
                      >
                        {cr.name}
                      </span>
                    ))}
                  </div>

                  {/* Bottom stage dot or subtle status */}
                  <div className="w-full flex justify-center">
                    {firstCrop && (
                      <span className="text-[9px] text-[#A7C0CC] font-mono leading-none truncate opacity-80">
                        {firstCrop.stage}
                      </span>
                    )}
                  </div>
                </button>
              );
            })}
          </div>

          {/* 4. Action Button Bar (Bottom of Calendar) */}
          <div className="flex items-center justify-between pt-3 border-t border-white/[0.08]">
            <span className="text-xs text-[#A7C0CC] font-mono">
              Selected: <strong className="text-white">{monthNames[currentMonth]} {selectedDayNumber}, {currentYear}</strong>
            </span>

            <button
              type="button"
              onClick={handleResetToday}
              className="px-4 py-2 rounded-xl bg-[#27D7B2] hover:bg-[#38E5C1] text-[#020A10] font-bold text-xs transition-all shadow-md cursor-pointer"
            >
              Today
            </button>
          </div>
        </div>

        {/* =================================================================== */}
        {/* RIGHT SIDE: ORGANIZED CROP DETAILS & MULTI-FARM ACTIVE BREAKDOWN    */}
        {/* =================================================================== */}
        <div className="lg:col-span-4 space-y-4">
          {/* Selected Date Card */}
          <div className="w-full rounded-2xl bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] p-5 sm:p-6 space-y-4 text-[#F0F7FA]">
            <div className="flex items-center justify-between pb-3 border-b border-white/[0.06]">
              <div className="flex items-center gap-2">
                <CalendarIcon className="w-4 h-4 text-[#27D7B2]" />
                <h3 className="text-base font-bold text-white tracking-tight">
                  Day Schedule: {monthNames[currentMonth]} {selectedDayNumber}
                </h3>
              </div>
              <span className="text-xs font-mono font-bold text-[#27D7B2] bg-[#032322] px-2.5 py-0.5 rounded-full border border-[#27D7B2]/40">
                {currentYear}
              </span>
            </div>

            {selectedCropsList.length > 0 ? (
              <div className="space-y-3">
                <span className="text-[11px] font-bold text-[#A7C0CC] uppercase tracking-wider block">
                  Crops Planted On This Day ({selectedCropsList.length} Farm{selectedCropsList.length > 1 ? 's' : ''})
                </span>

                {selectedCropsList.map((cropItem, idx) => {
                  const cfg = CROP_COLORS[cropItem.key] || CROP_COLORS.wheat;
                  const farmBadge = FARM_BADGE_COLORS[cropItem.farmId] || {
                    bg: 'bg-white/10',
                    border: 'border-white/20',
                    text: 'text-white',
                  };

                  return (
                    <div
                      key={idx}
                      className="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] space-y-2 hover:border-[#27D7B2]/40 transition-colors"
                    >
                      {/* Farm Association Header */}
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1.5 text-xs text-[#A7C0CC]">
                          <Building2 className="w-3.5 h-3.5 text-[#27D7B2]" />
                          <span className="font-semibold">{cropItem.farmName}</span>
                        </div>
                        <span className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold ${farmBadge.bg} ${farmBadge.border} ${farmBadge.text} border`}>
                          {cropItem.stage}
                        </span>
                      </div>

                      {/* Crop Name & Quick Link */}
                      <div className="flex items-center justify-between pt-1">
                        <div className="flex items-center gap-2.5">
                          <div
                            className="w-3.5 h-3.5 rounded-full shrink-0"
                            style={{ backgroundColor: cfg.dotColor }}
                          />
                          <button
                            type="button"
                            onClick={() => handleCropNameClick(cropItem.name, cropItem.farmId)}
                            className="text-base sm:text-lg font-bold text-white hover:text-[#27D7B2] hover:underline transition-colors text-left cursor-pointer flex items-center gap-1.5 group"
                            title={`Click to open ${cropItem.farmName}'s crop rotation details for ${cropItem.name}`}
                          >
                            <span>{cropItem.name}</span>
                            <ArrowRight className="w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-[#27D7B2]" />
                          </button>
                        </div>

                        <button
                          type="button"
                          onClick={() => handleCropNameClick(cropItem.name, cropItem.farmId)}
                          className="text-xs text-[#27D7B2] hover:text-[#38E5C1] font-semibold underline cursor-pointer"
                        >
                          View Rotation →
                        </button>
                      </div>

                      <p className="text-xs text-[#8EA3AF] leading-relaxed pt-1">
                        {cropItem.stage === 'Sowing'
                          ? 'Optimal planting window: Root-zone moisture and thermal accumulation favor rapid germination.'
                          : 'Active growth phase: Monitor soil moisture and keep irrigation aligned with root-zone depth.'}
                      </p>
                    </div>
                  );
                })}
              </div>
            ) : (
