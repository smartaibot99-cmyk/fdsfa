          title="View detailed weather telemetry"
        >
          <span>View Details</span>
          <ArrowRight className="w-3.5 h-3.5 text-[#27D7B2] group-hover:translate-x-0.5 transition-transform" />
        </button>
      </div>

      {/* Header divider */}
      <div className="w-full h-px bg-[#27D7B2]/30" />

      {/* ===================================================================== */}
      {/* 2. MAIN CURRENT WEATHER: [Large ☀]  28°C / Mostly sunny / H:32 L:22    */}
      {/* ===================================================================== */}
      <div className="flex items-center gap-6 sm:gap-8 py-1">
        {/* Large Sun Icon */}
        <div className="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center text-amber-400 shrink-0">
          <Sun className="w-16 h-16 sm:w-20 sm:h-20 fill-amber-400/90 text-amber-400" />
        </div>

        {/* Center/right weather readout */}
        <div className="space-y-0.5">
          <div className="text-5xl sm:text-6xl font-bold text-white tracking-tight leading-none font-sans">
            {tempC}°C
          </div>
          <div className="text-base sm:text-lg font-medium text-slate-100 font-sans pt-1">
            Mostly sunny
          </div>
          <div className="text-xs sm:text-sm font-medium text-[#8EA3AF] font-sans">
            H: {highTemp}° &nbsp;&nbsp; L: {lowTemp}°
          </div>
        </div>
      </div>

      {/* Divider underneath current conditions */}
      <div className="w-full h-px bg-[#27D7B2]/30" />

      {/* ===================================================================== */}
