  }

  const conditionText = isRainingRecently
    ? `Recent rain (${recentRainMm} mm in last 14 days) · ${vsNormalText}`
    : `No recent rain (${recentRainMm} mm) · ${vsNormalText}`;

  // 10. Growth Stage determination
