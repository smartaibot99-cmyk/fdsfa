import React from 'react';

export interface GlassCardProps extends React.HTMLAttributes<HTMLDivElement> {
  children: React.ReactNode;
  variant?: 'default' | 'subtle' | 'elevated' | 'dashed' | 'interactive' | 'ai';
  aiData?: boolean;
  className?: string;
  glow?: boolean;
}

export const GlassCard: React.FC<GlassCardProps> = ({
  children,
  variant = 'default',
  aiData = false,
  className = '',
  glow = false,
  ...props
}) => {
  let baseStyle = 'rounded-2xl transition-all duration-200 ';

  // If card uses AI data or has variant='ai', use the exact same dark navy background with a refined subtle teal accent border
  if (aiData || variant === 'ai') {
    baseStyle +=
      'bg-[#031522]/50 backdrop-blur-md border border-[#27D7B2]/35 shadow-[0_4px_24px_-4px_rgba(39,215,178,0.1)] ';
  } else {
    // Exact same card color and style as the Home page cards
    switch (variant) {
      case 'subtle':
        baseStyle += 'bg-[#031522]/40 backdrop-blur-md border border-white/[0.06] ';
        break;
      case 'dashed':
        baseStyle +=
          'bg-[#031522]/35 backdrop-blur-sm border-1.5 border-dashed border-white/[0.12] hover:border-[#27D7B2]/40 hover:bg-[#27D7B2]/5 ';
        break;
      case 'interactive':
        baseStyle +=
          'bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] hover:border-white/[0.16] hover:-translate-y-0.5 cursor-pointer ';
        break;
      case 'elevated':
      case 'default':
      default:
        baseStyle += 'bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] ';
        break;
    }
  }

  if (glow) {
    baseStyle +=
      'relative before:absolute before:-inset-px before:rounded-2xl before:bg-gradient-to-r before:from-[#27D7B2]/15 before:to-[#3BD9C2]/15 before:-z-10 before:blur-sm ';
  }

  return (
    <div className={`${baseStyle} ${className}`} {...props}>
      {children}
    </div>
  );
};


