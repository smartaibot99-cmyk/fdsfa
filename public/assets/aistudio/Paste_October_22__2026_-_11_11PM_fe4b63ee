    const customIcon = L.divIcon({
      className: 'custom-pin-wrapper',
      html: `
        <div style="position: relative; width: 32px; height: 32px; transform: translate(-16px, -32px);">
          <div style="position: absolute; inset: -4px; border-radius: 50%; background: rgba(56, 189, 248, 0.4); animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;"></div>
          <svg viewBox="0 0 24 24" width="32" height="32" fill="#38BDF8" stroke="#080A14" stroke-width="1.8" style="filter: drop-shadow(0 4px 10px rgba(0,0,0,0.7));">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
