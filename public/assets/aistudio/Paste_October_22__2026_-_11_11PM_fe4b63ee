        </div>
      );
    }
    return <Sun className="w-6 h-6 text-amber-400 fill-amber-400" />;
  };

  return (
    <div className="w-full rounded-2xl bg-[#031D29] border border-cyan-400/30 shadow-md p-5 sm:p-6 space-y-5 text-white transition-all">
      {/* ===================================================================== */}
