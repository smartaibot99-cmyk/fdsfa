import React, { useState } from 'react';
import { HeroSection } from './HeroSection';
import { FarmTrackerSelector } from './FarmTrackerSelector';
import { DailyFarmStatusCard } from './DailyFarmStatusCard';
import { DailyWeatherCard } from './DailyWeatherCard';
import { WaterIntelligenceCard } from './WaterIntelligenceCard';
import { SoilIntelligenceCard } from './SoilIntelligenceCard';
import { WatchHowItWorksModal } from './WatchHowItWorksModal';
import { SavedFarmPlan } from '../../types';
import { computeDailyStatusSnapshot } from '../../services/dailySnapshot';
import { LiveWeatherObservation } from '../../services/liveWeather';

interface HomeViewProps {
  onStartAnalysis: () => void;
  onNavigateTab: (tab: 'home' | 'farms' | 'analysis' | 'rotations' | 'simulator' | 'data' | 'wizard') => void;
  onOpenFarmSwitcher: () => void;
  activeFarm?: SavedFarmPlan;
  allFarms?: SavedFarmPlan[];
  onOpenGuide?: () => void;
  onSelectFarmId?: (farmId: string) => void;
  onOpenFarmDetail?: (farmId: string, initialSection?: 'tracker' | 'rotations' | 'settings', cropFilter?: string) => void;
  onOpenCropRotation?: (farmId: string, cropName?: string | null) => void;
  onWeatherLoaded?: (weather: LiveWeatherObservation) => void;
  onAlertDismissed?: (alertId: string) => void;
  isAdvanced?: boolean;
}

export const HomeView: React.FC<HomeViewProps> = ({
  onStartAnalysis,
  onNavigateTab,
  onOpenFarmSwitcher,
  activeFarm,
  allFarms = [],
  onOpenGuide,
  onSelectFarmId,
  onOpenFarmDetail,
  onOpenCropRotation,
  onWeatherLoaded,
  onAlertDismissed,
  isAdvanced = false,
}) => {
  const [isWatchModalOpen, setIsWatchModalOpen] = useState(false);
  const [alertTick, setAlertTick] = useState(0);

  // Selected farm for Home page (defaults to activeFarm or first farm in allFarms)
  const currentFarm = activeFarm || allFarms[0];

  // Compute daily snapshot from current farm
  const snapshot = currentFarm ? computeDailyStatusSnapshot(currentFarm) : null;

  const handleSelectFarm = (farmId: string) => {
    if (onSelectFarmId) {
      onSelectFarmId(farmId);
    }
  };

  const handleAlertDismissed = (alertId: string) => {
    setAlertTick((t) => t + 1);
    if (onAlertDismissed) {
      onAlertDismissed(alertId);
    }
  };

  return (
    <div className="w-full flex flex-col space-y-5 pb-14">
      {/* 1. HERO SECTION (Kept as requested) */}
      <HeroSection
        onStartAnalysis={onStartAnalysis}
        onWatchHowItWorks={() => setIsWatchModalOpen(true)}
        onOpenGuide={onOpenGuide}
      />

      {/* 2. DAILY FARM TRACKER CONTAINER */}
      <div className="max-w-[1440px] w-full mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        {/* Page-level farm selector (Single source of truth for weather & status) */}
        {allFarms.length > 0 && currentFarm && (
          <FarmTrackerSelector
            farms={allFarms}
            selectedFarmId={currentFarm.id}
            onSelectFarm={handleSelectFarm}
            onAddNewFarm={onStartAnalysis}
          />
        )}

        {/* TRACKER CONTENT: Dynamic Farm Status Card & Compact Weather Card */}
        {snapshot ? (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
            {/* The Main Farm Status Card (~8 cols on desktop, grows dynamically) */}
            <div className="lg:col-span-8">
              <DailyFarmStatusCard
                key={`${snapshot.farmId}_${alertTick}`}
                snapshot={snapshot}
                farm={currentFarm}
                isAdvanced={isAdvanced}
                onViewRotation={() => {
                  if (onOpenCropRotation && currentFarm) {
                    onOpenCropRotation(currentFarm.id, null);
                  } else if (onOpenFarmDetail && currentFarm) {
                    onOpenFarmDetail(currentFarm.id, 'rotations');
                  } else {
                    onNavigateTab('rotations');
                  }
                }}
                onViewFarmDetail={() => {
                  if (onOpenFarmDetail && currentFarm) {
                    onOpenFarmDetail(currentFarm.id, 'tracker');
                  } else {
                    onNavigateTab('farms');
                  }
                }}
                onCropClick={(cropName, fId) => {
                  const targetFarmId = fId || currentFarm?.id;
                  if (targetFarmId && onOpenCropRotation) {
                    onOpenCropRotation(targetFarmId, cropName);
                  } else if (targetFarmId && onOpenFarmDetail) {
                    onOpenFarmDetail(targetFarmId, 'rotations', cropName);
                  } else {
                    onNavigateTab('rotations');
                  }
                }}
                onAlertDismissed={handleAlertDismissed}
              />
            </div>

            {/* Weather Card (~4 cols, purely weather focused) */}
            <div className="lg:col-span-4">
              <DailyWeatherCard
                snapshot={snapshot}
                farm={currentFarm}
                isAdvanced={isAdvanced}
                onWeatherLoaded={onWeatherLoaded}
                onViewDetails={() => onNavigateTab('analysis')}
              />
            </div>
          </div>
        ) : (
          <div className="p-8 rounded-2xl bg-[#031D2A]/80 border border-[#27D7B2]/30 text-center space-y-3">
            <h3 className="text-base font-bold text-white">No Farm Selected</h3>
            <p className="text-xs text-[#A7C0CC]">
              Start an analysis to begin tracking your farm's daily environmental status.
            </p>
            <button
              type="button"
              onClick={onStartAnalysis}
              className="px-4 py-2 rounded-xl bg-[#27D7B2] text-[#020A10] font-bold text-xs"
            >
              Start New Analysis
            </button>
          </div>
        )}

        {/* ADVANCED MODE EXCLUSIVE: WATER INTELLIGENCE & SOIL INTELLIGENCE CARDS */}
        {isAdvanced && (
          <div className="space-y-6 pt-4 border-t border-slate-800">
            <div className="flex items-center justify-between">
              <div>
                <h2 className="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  Advanced Agronomic Intelligence
                </h2>
                <p className="text-sm text-slate-400 mt-0.5">
                  Real-time FAO-56 dual crop evapotranspiration and calibrated ISRIC pedology profiles.
                </p>
              </div>
              <span className="px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                Advanced Mode
              </span>
            </div>

            <div className="space-y-6">
              <WaterIntelligenceCard farm={currentFarm || allFarms[0]} />
              <SoilIntelligenceCard farm={currentFarm || allFarms[0]} />
            </div>
          </div>
        )}
      </div>

      {/* Video / Interactive Explainer Modal */}
      <WatchHowItWorksModal
        isOpen={isWatchModalOpen}
        onClose={() => setIsWatchModalOpen(false)}
        onStartAnalysis={onStartAnalysis}
      />
    </div>
  );
};


