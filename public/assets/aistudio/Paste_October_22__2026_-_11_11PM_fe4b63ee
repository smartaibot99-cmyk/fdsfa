} from 'lucide-react';
import { FarmAnswers, RotationResult, ClimateObservation } from '../../types';
import { sendAiAgronomistMessage } from '../../services/aiService';

export interface AIAgronomistChatProps {
  farmAnswers: FarmAnswers;
  farmName?: string;
  selectedRotation?: RotationResult;
  climateData?: ClimateObservation;
  isOpen: boolean;
  onClose: () => void;
}

interface MessageItem {
  id: string;
  role: 'user' | 'model';
  text: string;
  time: string;
}

export const AIAgronomistChat: React.FC<AIAgronomistChatProps> = ({
  farmAnswers,
  farmName,
  selectedRotation,
  climateData,
  isOpen,
  onClose,
}) => {
  const [messages, setMessages] = useState<MessageItem[]>([
    {
      id: 'welcome',
      role: 'model',
      text: `Hello! I'm your Field Shift AI Agronomist, connected directly to your field inputs and NASA Earth observations.\n\nCurrently analyzing **${farmName || farmAnswers.farmName || 'Your Farm'}** (${farmAnswers.locationName || 'Salina, Kansas'}) with **${farmAnswers.soilTexture?.replace('_', ' ') || 'Silt Loam'}** soil and **${farmAnswers.irrigationMode === 'rain_only' ? 'Rain-fed' : 'Irrigated'}** management.\n\nAsk me anything about why this rotation was selected, nitrogen dynamics, water risk buffering, or planting schedules!`,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    },
  ]);
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const messagesEndRef = useRef<HTMLDivElement>(null);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    if (isOpen) {
      scrollToBottom();
    }
  }, [messages, isOpen]);

  const handleSend = async (textToSend?: string) => {
    const query = textToSend || input;
    if (!query.trim() || isLoading) return;

    const userMsg: MessageItem = {
      id: `u-${Date.now()}`,
      role: 'user',
      text: query,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    };

    setMessages((prev) => [...prev, userMsg]);
    if (!textToSend) setInput('');
    setIsLoading(true);

    try {
      const history = messages.map((m) => ({ role: m.role, text: m.text }));
      const replyText = await sendAiAgronomistMessage(query, history, {
        farmAnswers,
        selectedRotation,
        climateData,
      });

      const modelMsg: MessageItem = {
        id: `m-${Date.now()}`,
        role: 'model',
        text: replyText,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      };
      setMessages((prev) => [...prev, modelMsg]);
    } catch (err) {
      console.error(err);
      const errorMsg: MessageItem = {
        id: `err-${Date.now()}`,
        role: 'model',
