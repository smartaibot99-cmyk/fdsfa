              className={`p-4 rounded-xl border text-left transition-all cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${
                isActive
                  ? 'border-[#42D6AE] bg-[#42D6AE]/10 shadow-lg shadow-[#42D6AE]/5'
