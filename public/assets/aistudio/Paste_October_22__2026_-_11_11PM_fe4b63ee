import express from 'express';
import { createServer as createViteServer } from 'vite';
import { GoogleGenAI } from '@google/genai';
import dotenv from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
app.use(express.json());

const ai = new GoogleGenAI();

// Endpoint for AI Agronomic Description of Rotation
app.post('/api/ai-description', async (req, res) => {
  try {
    const { rotation, farmAnswers, climateData } = req.body;
    const prompt = `You are a precision agronomist AI for Field Shift.
Provide a clear, authoritative, tailored 2-3 sentence explanation (~60-80 words) for why this specific crop rotation is recommended for this farmer.
You MUST directly reference the user's specific inputs:
- Rotation: ${rotation?.name || 'Crop Rotation'} (Sequence: ${rotation?.sequence?.map((s: any) => s.cropName).join(' → ') || 'Wheat → Lettuce → Beans → Maize'})
- Farm Location: ${farmAnswers?.locationName || 'Salina, Kansas, USA'}
- Soil Texture: ${farmAnswers?.soilTexture?.replace('_', ' ') || 'Silt Loam'}
- Irrigation Mode: ${farmAnswers?.irrigationMode === 'rain_only' ? 'Rain-fed' : 'Irrigated'}
- Historical Crops: ${farmAnswers?.cropHistory?.length ? farmAnswers.cropHistory.map((h: any) => h.cropId).join(', ') : 'None / Fallow / Virgin field (First time cultivation)'}
- Farmer Priorities: Water Saving (${farmAnswers?.priorities?.waterSaving ?? 3}/4), Soil Health (${farmAnswers?.priorities?.soilHealth ?? 3}/4), Climate Resilience (${farmAnswers?.priorities?.climateResilience ?? 3}/4)
- Climate: ${climateData?.annualPrecipitationMm ?? 820}mm rainfall, ${climateData?.meanTempC ?? 14}°C.

Focus on the exact agronomic mechanisms (soil nitrogen dynamics, disease break, water conservation) that make this sequence optimal for their inputs.`;

    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents: prompt,
      config: {
        systemInstruction: 'You are the Field Shift AI Agronomist. Deliver concise, scientifically grounded, farmer-friendly rationale directly connecting the recommended rotation with the user’s soil, water, history, and priorities.',
      },
    });

    res.json({ description: response.text });
  } catch (error: any) {
    console.error('Error generating AI description:', error);
    res.status(500).json({ error: error.message || 'Failed to generate explanation' });
  }
});

// Endpoint for AI Bot Chat
app.post('/api/ai-chat', async (req, res) => {
  try {
    const { message, history, context } = req.body;

    const systemInstruction = `You are the Field Shift AI Agronomist, an expert precision agriculture advisor connected to the farmer's live field inputs, rotation plans, and NASA Earth observations.

Current Farm Context:
- Location: ${context?.farmAnswers?.locationName || 'Salina, Kansas, USA'}
- Soil Texture: ${context?.farmAnswers?.soilTexture?.replace('_', ' ') || 'Silt Loam'}
- Irrigation Mode: ${context?.farmAnswers?.irrigationMode === 'rain_only' ? 'Rain-fed' : 'Irrigated'}
- Prior Crops: ${context?.farmAnswers?.cropHistory?.length ? context?.farmAnswers?.cropHistory.map((h: any) => h.cropId).join(', ') : 'None / Fallow / Virgin field (First time cultivation)'}
- Stated Priorities: Water Saving (${context?.farmAnswers?.priorities?.waterSaving ?? 3}/4), Soil Health (${context?.farmAnswers?.priorities?.soilHealth ?? 3}/4), Resilience (${context?.farmAnswers?.priorities?.climateResilience ?? 3}/4)
- Climate Telemetry: ${context?.climateData?.annualPrecipitationMm ?? 820}mm annual rainfall, Root-Zone Moisture: ${context?.climateData?.soilMoisturePercentile ?? 55}th percentile.
- Active Rotation Plan: ${context?.selectedRotation?.name || 'Rotation 1'} (${context?.selectedRotation?.sequence?.map((s: any) => s.cropName).join(' → ') || 'Wheat → Lettuce → Beans → Maize'}, Score: ${context?.selectedRotation?.totalScore || 92}/100)

Always answer questions accurately, scientifically, concisely, and specifically referencing their field inputs and selected rotation. Keep responses clear, practical, and formatted with clean paragraphs or bullet points.`;

    const contents = [
      ...(history || []).map((h: any) => ({
        role: h.role === 'user' ? 'user' : 'model',
        parts: [{ text: h.text }],
      })),
      { role: 'user', parts: [{ text: message }] },
    ];

    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents,
      config: {
        systemInstruction,
      },
    });

    res.json({ reply: response.text });
  } catch (error: any) {
    console.error('Error in AI chat:', error);
    res.status(500).json({ error: error.message || 'Failed to generate chat reply' });
  }
});

// Endpoint to download the 100% complete source code zip archive
app.get('/api/download-source', (_req, res) => {
  const filePath = path.resolve(__dirname, 'public', 'agrisoil-complete-source.zip');
  res.download(filePath, 'agrisoil-complete-source.zip');
});

// Endpoint to view/fetch the 100% complete single-file text dump of all code
app.get('/api/all-code-text', (_req, res) => {
  const filePath = path.resolve(__dirname, 'public', 'all_code_dump.txt');
  res.setHeader('Content-Type', 'text/plain; charset=utf-8');
  res.sendFile(filePath);
});


const isProduction = process.env.NODE_ENV === 'production';
const PORT = Number(process.env.PORT) || 3000;

if (!isProduction) {
  const vite = await createViteServer({
    server: { middlewareMode: true },
    appType: 'spa',
  });
  app.use(vite.middlewares);
} else {
  app.use(express.static(path.resolve(__dirname, 'dist')));
  app.get('*', (_req, res) => {
    res.sendFile(path.resolve(__dirname, 'dist', 'index.html'));
  });
}

app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});


