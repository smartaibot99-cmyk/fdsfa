      aiRationale: 'Conditions the seedbed with low C:N ratio organic residues, preparing optimal soil tilth for the subsequent summer or grain crop.',
      actionAdvice: 'Ensure sowing into firm, non-saline seedbed; maintain weed-free early vegetative stage.'
    },
    sorghum: {
      role: 'Heat-Tolerant C4 Scavenger & Subsoil Miner',
      rootDepth: 'Extensive deep root system reaching 1.5–2.0 m depth',
      nitrogenImpact: 'Highly efficient nitrogen scavenger; extracts deep subsoil nitrates prevented from leaching',
      diseaseBreak: 'Completely breaks winter-crop fungal host cycles and soil-borne cyst nematodes',
      waterProfile: 'High drought resilience; regulates stomatal aperture under extreme VPD and heat stress',
      aiRationale: 'Extracts deep moisture beyond the reach of pulses and wheat while delivering heavy carbon-rich residues that rebuild long-term humus.',
      actionAdvice: 'Wait until soil temperature exceeds 16°C before drilling seed; preserve mulch canopy.'
    },
    barley: {
      role: 'Saline-Tolerant Early-Maturing Cereal',
      rootDepth: 'Fibrous surface root mass (0–70 cm)',
      nitrogenImpact: 'Moderate consumer; efficient uptake of early available nitrates',
      diseaseBreak: 'Interrupts broadleaf root pathogens; rapidly establishes weed-suppressing ground canopy',
      waterProfile: 'Extremely efficient water use with short vegetative cycle avoiding late seasonal drought',
      aiRationale: 'Provides rapid ground cover and reliable grain yield even in marginal soil moisture conditions.',
      actionAdvice: 'Seed into uniform seedbed depth (3–4 cm); adjust fertilizer based on soil testing.'
    },
    fallow: {
      role: 'Strategic Moisture Recharge & Bio-Solarization Rest',
      rootDepth: 'No active crop; capillary barrier maintained via surface stubble mulch',
      nitrogenImpact: 'Mineralizes 20–30 kg N/ha organic nitrogen without plant uptake depletion',
      diseaseBreak: 'Deprives host-obligate pathogens and weed seeds of life-cycle continuation',
      waterProfile: 'Conserves 40–60 mm of deep profile water reserves for subsequent planting',
      aiRationale: 'Recharges root-zone water storage in arid or low-rainfall periods while breaking pest cycles naturally.',
      actionAdvice: 'Keep surface clean with light non-inversion tillage or mulch cover to block capillary evaporative loss.'
    },
    cover_crop: {
      role: 'Biological Armor & Soil Infiltration Enhancer',
      rootDepth: 'Multi-species mixed root profiles (shallow taproots + fibrous networks)',
      nitrogenImpact: 'Scavenges residual nutrients, prevents leaching, and injects root exudates into microbiome',
      diseaseBreak: 'Bio-fumigant root exudates suppress soil-borne fungal pathogens and plant-parasitic nematodes',
      waterProfile: 'Increases rainfall infiltration by +35% and dramatically reduces surface run-off',
      aiRationale: 'Protects fragile topsoil against wind and water erosion while feeding the beneficial microbial food web.',
      actionAdvice: 'Terminate mechanically or naturally at early heading to preserve water reserves.'
    }
  };

  const getCropProfile = (cropName: string) => {
    const n = cropName.toLowerCase();
    if (n.includes('wheat')) return CROP_AGRONOMIC_PROFILES.wheat;
    if (n.includes('chickpea')) return CROP_AGRONOMIC_PROFILES.chickpea;
    if (n.includes('lentil')) return CROP_AGRONOMIC_PROFILES.lentil;
    if (n.includes('sorghum')) return CROP_AGRONOMIC_PROFILES.sorghum;
    if (n.includes('barley')) return CROP_AGRONOMIC_PROFILES.barley;
    if (n.includes('fallow')) return CROP_AGRONOMIC_PROFILES.fallow;
    if (n.includes('cover')) return CROP_AGRONOMIC_PROFILES.cover_crop;
    return CROP_AGRONOMIC_PROFILES.wheat;
  };

  const aiDescriptionText = useMemo(() => {
    const cropNames = sequenceCrops.map((c) => c.name);
    const soil = (analysis?.farmAnswers?.soilTexture || 'loam').replace('_', ' ');
    const rain = analysis?.climateData?.annualPrecipitationMm ?? 350;
    const isArid = rain < 450;
    const isBad = selectedRotation.totalScore < 65 || selectedRotation.isRecommended === false;

    if (!isAdvanced) {
      if (isBad) {
        return `Notice: Rotation #${selectedRotation.rank} (${cropNames.join(' → ')}) scored ${selectedRotation.totalScore}/100 and has higher risk due to water demand or soil disease. We recommend choosing a higher-scoring rotation.`;
      }
      return `Recommended ${cropNames.length}-crop sequence (${cropNames.join(' → ')}) for ${currentFarmName}. Alternates cereal grain with nitrogen-replenishing pulses to maintain balanced soil nutrition and reduce pests.`;
    }

    if (isBad) {
      return `Critical Agronomic Evaluation & Risk Warning: Rotation #${selectedRotation.rank} (${cropNames.join(' → ')}) scored ${selectedRotation.totalScore}/100 and is NOT recommended for sustainable deployment on ${currentFarmName}. ${selectedRotation.notRecommendedReason || 'It exhibits high water-deficit stress or repeated host vulnerability for soil-borne pathogens.'} Deploying this sequence will deplete root-zone water reserves, amplify Fusarium crown rot and root-lesion nematodes, and require heavy compensatory synthetic inputs with high financial risk.`;
    }

    return `The AI Agronomist engine analyzed ${currentFarmName}'s ${soil} soil texture and ${rain} mm annual precipitation profile to synthesize this ${cropNames.length}-crop sequence (${cropNames.join(' → ')}). By alternating heavy-feeding cereals with restorative nitrogen-fixing pulses, this plan creates a self-sustaining nutrient-cycling loop. The sequence strategically alternates root-zone depths—utilizing deep taproots to scavenge subsoil moisture followed by fibrous cereal roots that bind topsoil and replenish soil organic matter. Crucially, transitioning across distinct botanical families disrupts the reproductive life cycle of soil-borne fungal pathogens (such as Fusarium and crown rot) and root-lesion nematodes, reducing chemical fungicide intervention while buffering ${currentFarmName} against ${isArid ? 'severe evaporative moisture deficits' : 'seasonal climatic fluctuations'}.`;
  }, [sequenceCrops, analysis, currentFarmName, selectedRotation, isAdvanced]);

  const activeSpotlightCrop = useMemo(() => {
    if (!selectedCropName) return null;
    return sequenceCrops.find(
      (c) => c.name.toLowerCase() === selectedCropName.toLowerCase()
    ) || sequenceCrops[0];
  }, [selectedCropName, sequenceCrops]);

  return (
    <div className="w-full space-y-6 max-w-[1440px] mx-auto py-2 text-[#F0F7FA]">
      {/* ========================================================================= */}
      {/* 1. HERO FARMLAND BANNER & PAGE HEADING                                    */}
      {/* ========================================================================= */}
      <div className="relative rounded-2xl overflow-hidden border border-white/[0.08] shadow-xl">
        {/* Background Aerial Farmland Image with Dark Navy Glass Overlay */}
        <div className="absolute inset-0 z-0">
          <img
            src={aerialMarjan}
            alt="Agricultural farmland"
            className="w-full h-full object-cover object-center filter brightness-[0.45] saturate-[1.1]"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-[#031421]/95 via-[#031421]/90 to-[#031421]/80 backdrop-blur-[2px]" />
        </div>

        {/* Hero Content */}
        <div className="relative z-10 p-6 sm:p-8 space-y-5">
          <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            {/* Left: Titles */}
            <div className="space-y-1 max-w-2xl">
              <span className="text-[11px] font-mono font-bold text-[#20DCC0] uppercase tracking-wider block">
                CROP ROTATION PLANS
              </span>
              <h1 className="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
                Crop Rotation Plans
              </h1>
              <p className="text-xs sm:text-sm text-[#8EA3AF] leading-relaxed pt-1">
                Ranked crop sequences tailored to your local soil moisture, rainfall history, and farm priorities.
              </p>
            </div>

            {/* Right: Farm Selector Dropdown & Ask AI Agronomist Button */}
            <div className="flex flex-wrap items-center gap-3">
              {/* Farm Selector Dropdown */}
              <div className="relative">
                <button
                  type="button"
                  onClick={() => setIsFarmDropdownOpen(!isFarmDropdownOpen)}
                  className="px-3.5 py-2 rounded-xl bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/[0.12] hover:border-[#20DCC0]/40 text-white flex items-center gap-2 text-xs font-semibold transition-all cursor-pointer shadow-sm"
                >
                  <MapPin className="w-3.5 h-3.5 text-[#20DCC0]" />
                  <span>{currentFarmName}</span>
                  <ChevronDown className="w-3.5 h-3.5 text-[#8EA3AF]" />
                </button>

                {isFarmDropdownOpen && farms.length > 0 && (
                  <div className="absolute right-0 mt-1.5 w-52 rounded-xl bg-[#031D2A] border border-[#20DCC0]/30 shadow-2xl p-1.5 z-50 space-y-1">
                    <span className="text-[10px] font-mono uppercase text-[#8EA3AF] px-2 py-1 block">
                      Switch Farm Parcel
                    </span>
                    {farms.map((f) => (
                      <button
                        key={f.id}
                        type="button"
                        onClick={() => {
                          if (onSelectFarmId) onSelectFarmId(f.id);
                          setIsFarmDropdownOpen(false);
                        }}
                        className={`w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center justify-between ${
                          f.id === activeFarmId || f.name === currentFarmName
                            ? 'bg-[#20DCC0]/20 text-[#20DCC0] font-bold'
                            : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
                        }`}
                      >
                        <span className="truncate">{f.name}</span>
                        {(f.id === activeFarmId || f.name === currentFarmName) && (
                          <CheckCircle2 className="w-3.5 h-3.5 text-[#20DCC0] shrink-0" />
                        )}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              {/* Ask AI Agronomist Button */}
              <button
                type="button"
                onClick={onOpenAiBot ? onOpenAiBot : () => setIsAiChatOpen(true)}
                className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#20DCC0] to-[#1AB8A0] hover:brightness-105 active:scale-[0.98] text-[#020A10] font-bold text-xs flex items-center gap-2 shadow-md transition-all cursor-pointer"
              >
                <Sparkles className="w-3.5 h-3.5 fill-[#020A10]" />
                <span>Ask AI Agronomist</span>
              </button>
            </div>
          </div>

          {/* Secondary Navigation: In Simple mode, only Rotation Plans is shown. In Advanced mode, both Rotation Plans and Sequence Analysis are available */}
          <div className="pt-2 border-t border-white/[0.08] flex items-center gap-2">
            <button
              type="button"
              onClick={() => setActiveTab('plans')}
              className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition-all cursor-pointer ${
                activeTab === 'plans'
                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400 font-bold shadow-sm'
                  : 'bg-black/20 text-[#8EA3AF] border border-transparent hover:text-white hover:bg-white/[0.04]'
              }`}
            >
              <RefreshCw className="w-3.5 h-3.5" />
              <span>Rotation Plans</span>
            </button>

            {isAdvanced && (
              <button
                type="button"
                onClick={() => setActiveTab('analysis')}
                className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition-all cursor-pointer ${
                  activeTab === 'analysis'
                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400 font-bold shadow-sm'
                    : 'bg-black/20 text-[#8EA3AF] border border-transparent hover:text-white hover:bg-white/[0.04]'
                }`}
              >
                <BarChart3 className="w-3.5 h-3.5" />
                <span>Sequence Analysis</span>
              </button>
            )}
          </div>
        </div>
      </div>

      {/* ========================================================================= */}
      {/* TAB 1: ROTATION PLANS DASHBOARD                                            */}
      {/* ========================================================================= */}
      {activeTab === 'plans' && (
        <div className="space-y-6">
          {/* ADVANCED MODE ONLY: TOP RANKED ROTATION CARDS (BEST SCORE TO LOWEST SCORE) */}
          {isAdvanced && (
            <div className="p-4 sm:p-5 rounded-2xl bg-[#091520] border border-slate-700/80 shadow-sm space-y-3">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div className="flex items-center gap-2">
                    <span className="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">
                      ADVANCED ROTATION EVALUATION
                    </span>
                    <span className="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                      {sortedRotations.length} Scored Options
                    </span>
                  </div>
                  <h3 className="text-base sm:text-lg font-bold text-white tracking-tight mt-0.5">
                    All Evaluated Rotation Plans (Ranked Best to Lowest Score)
                  </h3>
                  <p className="text-xs text-slate-400 mt-0.5">
                    Click any rotation card below to immediately switch all data, timelines, AI evaluations, and risk analyses on this page to that rotation.
                  </p>
                </div>
              </div>

              {/* Scrollable / Responsive Card Grid */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 pt-1">
                {sortedRotations.map((rot) => {
                  const isSelected = rot.id === selectedRotation.id;
                  const isPoor = rot.totalScore < 65 || rot.isRecommended === false;
                  const isOptimal = rot.totalScore >= 85;

                  return (
                    <button
                      key={rot.id}
                      type="button"
                      onClick={() => setSelectedRotationId(rot.id)}
                      className={`p-3 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between space-y-2 relative ${
                        isSelected
                          ? 'bg-slate-800 border-cyan-400 ring-1 ring-cyan-400/50 shadow-sm'
                          : 'bg-slate-900/90 border-slate-800 hover:border-slate-700 hover:bg-slate-850'
                      }`}
                    >
                      <div className="flex items-center justify-between gap-1 w-full">
                        <span className="text-xs font-mono font-bold text-slate-300">
                          #{rot.rank}
                        </span>
                        <span className={`px-2 py-0.5 rounded text-xs font-mono font-bold ${
                          isOptimal
                            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
                            : isPoor
                            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30'
                            : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'
                        }`}>
                          {rot.totalScore}%
                        </span>
                      </div>

                      <div className="space-y-1">
                        <div className="text-xs font-bold text-white line-clamp-2 leading-tight">
                          {rot.sequence?.map((s) => s.cropName).join(' → ') || rot.name}
                        </div>
                        <span className="text-xs text-slate-400 block font-mono">
                          {rot.cycleLengthYears || rot.cycleLengthSeasons || 4}-Season Cycle
                        </span>
                      </div>

                      <div className="pt-2 border-t border-slate-800 flex items-center justify-between text-xs w-full">
                        <span className={`font-semibold ${
                          isOptimal
                            ? 'text-emerald-400'
                            : isPoor
                            ? 'text-rose-400'
                            : 'text-slate-300'
                        }`}>
                          {isOptimal ? 'Recommended' : isPoor ? 'High Risk' : 'Alternative'}
                        </span>
                        <span className={`font-mono text-xs ${isSelected ? 'text-cyan-400 font-bold' : 'text-slate-500'}`}>
                          {isSelected ? 'Active ●' : 'Inspect'}
                        </span>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {/* ===================================================================== */}
          {/* 0. PROMINENT AI AGRONOMIC SYNTHESIS & ROTATION INTELLIGENCE MODULE    */}
          {/* ===================================================================== */}
          <div className="rounded-2xl bg-[#091520] border border-slate-700/80 p-5 sm:p-7 space-y-5 shadow-sm relative overflow-hidden">
            {/* Header */}
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3.5 border-b border-slate-800 relative z-10">
              <div className="flex items-start gap-3">
                <div className="w-9 h-9 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-cyan-400 shrink-0">
                  <Sparkles className="w-5 h-5" />
                </div>
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <span className="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
                      AI Agronomic Description
                    </span>
                    <span className={`px-2 py-0.5 rounded text-xs font-bold font-mono ${
                      selectedRotation.totalScore >= 80
                        ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                        : selectedRotation.totalScore < 65
                        ? 'bg-rose-500/15 text-rose-300 border border-rose-500/30'
                        : 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30'
                    }`}>
                      #{selectedRotation.rank} · {selectedRotation.totalScore || 92}% Match Score
                    </span>
                  </div>
                  <h2 className="text-lg sm:text-xl font-bold text-white tracking-tight mt-0.5">
                    Agronomic Intelligence for {currentFarmName}
                  </h2>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={onOpenAiBot ? onOpenAiBot : () => setIsAiChatOpen(true)}
                  className="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-750 text-cyan-300 border border-slate-700 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
                >
                  <Sparkles className="w-3.5 h-3.5" />
                  <span>Ask AI Agronomist</span>
                </button>
              </div>
            </div>

            {/* Narrative & Active Crop Spotlight */}
            <div className="relative z-10 space-y-4">
              {/* Primary AI Synthesis Narrative */}
              <p className="text-xs sm:text-sm text-slate-100 font-sans leading-relaxed">
                {aiDescriptionText}
              </p>

              {/* Crop Selector Filter Strip */}
              <div className="flex flex-wrap items-center gap-2 pt-1 border-t border-white/[0.06]">
                <span className="text-xs font-mono text-[#8EA3AF] font-semibold mr-1">
                  Inspect Crop In Cycle:
                </span>
                {sequenceCrops.map((c) => {
                  const isFocused = selectedCropName?.toLowerCase() === c.name.toLowerCase();
                  return (
                    <button
                      key={c.id}
                      type="button"
                      onClick={() => setSelectedCropName(isFocused ? null : c.name)}
                      className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 ${
                        isFocused
                          ? 'bg-cyan-400 text-slate-950 font-bold shadow-sm'
                          : 'bg-black/35 border border-white/[0.1] text-white hover:border-[#20DCC0]/50 hover:bg-[#20DCC0]/10'
                      }`}
                    >
                      <span
                        className="w-2 h-2 rounded-full"
                        style={{ backgroundColor: isFocused ? '#020A10' : '#20DCC0' }}
                      />
                      <span>{c.name}</span>
                      <span className="text-[10px] opacity-75 font-mono">({c.seasonLabel})</span>
                    </button>
                  );
                })}
                {selectedCropName && (
                  <button
                    type="button"
                    onClick={() => {
                      setSelectedCropName(null);
                      if (onClearCropFocus) onClearCropFocus();
                    }}
                    className="px-2.5 py-1 rounded-xl text-[11px] font-semibold text-[#8EA3AF] hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                  >
                    ✕ Clear Spotlight
                  </button>
                )}
              </div>

              {/* SPOTLIGHT PANEL: Displayed when a crop is selected / focused */}
              {activeSpotlightCrop && (
                <div className="p-4 sm:p-5 rounded-xl bg-black/45 border border-[#20DCC0]/40 space-y-3.5 animate-in fade-in duration-200">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-white/[0.08]">
                    <div className="flex items-center gap-3">
                      <div className="w-12 h-12 rounded-xl overflow-hidden border border-[#20DCC0]/50 shrink-0 bg-black/30">
                        <img
                          src={activeSpotlightCrop.image}
                          alt={activeSpotlightCrop.name}
                          className="w-full h-full object-cover"
                        />
                      </div>
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="text-base font-bold text-white">
                            {activeSpotlightCrop.name}
                          </span>
                          <span className="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#20DCC0]/20 text-[#20DCC0]">
                            {activeSpotlightCrop.seasonLabel} · ~{activeSpotlightCrop.durationDays} Days
                          </span>
                        </div>
                        <span className="text-xs text-[#20DCC0] font-medium block">
                          {getCropProfile(activeSpotlightCrop.name).role}
                        </span>
                      </div>
                    </div>

                    <button
                      type="button"
                      onClick={() => {
                        setSelectedCropName(null);
                        if (onClearCropFocus) onClearCropFocus();
                      }}
                      className="text-xs text-[#8EA3AF] hover:text-white transition-colors cursor-pointer self-start sm:self-auto"
                    >
                      Close ✕
                    </button>
                  </div>

                  {/* AI Detailed Crop Evaluation Grid */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
                    <div className="p-2.5 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-1">
                      <span className="text-[#8EA3AF] block font-mono text-[10px] uppercase font-bold">
                        Root-Zone Profile
                      </span>
                      <p className="text-white font-medium">
                        {getCropProfile(activeSpotlightCrop.name).rootDepth}
                      </p>
                    </div>

                    <div className="p-2.5 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-1">
                      <span className="text-[#8EA3AF] block font-mono text-[10px] uppercase font-bold">
                        Nitrogen &amp; Soil Role
                      </span>
                      <p className="text-white font-medium">
                        {getCropProfile(activeSpotlightCrop.name).nitrogenImpact}
                      </p>
                    </div>

                    <div className="p-2.5 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-1">
                      <span className="text-[#8EA3AF] block font-mono text-[10px] uppercase font-bold">
                        Pathogen Break
                      </span>
                      <p className="text-white font-medium">
                        {getCropProfile(activeSpotlightCrop.name).diseaseBreak}
                      </p>
                    </div>

                    <div className="p-2.5 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-1">
                      <span className="text-[#8EA3AF] block font-mono text-[10px] uppercase font-bold">
                        Hydrological Dynamics
                      </span>
                      <p className="text-white font-medium">
                        {getCropProfile(activeSpotlightCrop.name).waterProfile}
                      </p>
                    </div>
                  </div>

                  <div className="p-3 rounded-lg bg-[#20DCC0]/10 border border-[#20DCC0]/25 text-xs text-slate-200">
                    <strong className="text-[#20DCC0] font-semibold">AI Operational Rationale: </strong>
                    {getCropProfile(activeSpotlightCrop.name).aiRationale}{' '}
                    <span className="text-[#8EA3AF]">Action: {getCropProfile(activeSpotlightCrop.name).actionAdvice}</span>
                  </div>
                </div>
              )}

              {/* 3 AI Agronomic Pillars */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-3.5 pt-1">
                <div className="p-3.5 rounded-xl bg-black/25 border border-white/[0.08] space-y-1.5">
                  <div className="flex items-center gap-2 text-xs font-bold text-[#20DCC0]">
                    <Leaf className="w-4 h-4 text-[#20DCC0]" />
                    <span>Biological Nitrogen &amp; Health</span>
                  </div>
                  <p className="text-xs text-[#9BB1BD] leading-relaxed">
                    Legume phases fix atmospheric N via Rhizobia nodules, significantly reducing synthetic urea dependency.
                  </p>
                </div>

                <div className="p-3.5 rounded-xl bg-black/25 border border-white/[0.08] space-y-1.5">
                  <div className="flex items-center gap-2 text-xs font-bold text-[#20DCC0]">
                    <ShieldCheck className="w-4 h-4 text-[#20DCC0]" />
                    <span>Pathogen Spore Interruption</span>
                  </div>
                  <p className="text-xs text-[#9BB1BD] leading-relaxed">
                    Alternating botanical families breaks host cycles for cereal rusts, Fusarium crown rot, and nematodes.
                  </p>
