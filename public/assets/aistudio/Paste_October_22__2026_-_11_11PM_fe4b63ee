                  isCritical
                    ? 'bg-amber-500/10 border-amber-400/35 hover:border-amber-400/70 hover:bg-amber-500/15 shadow-sm'
                    : 'bg-[#041D2A]/85 border-[#27D7B2]/25 hover:border-[#27D7B2]/50 hover:bg-[#041D2A]'
