                <span className="text-[#8EA3AF]">Soil Type:</span>
                <span className="text-white text-xs font-medium capitalize">
                  {farm.farmAnswers?.soilTexture?.replace('_', ' ') || 'Silt Loam'}
                </span>
              </div>
              <div className="flex justify-between items-center text-xs">
                <span className="text-[#8EA3AF]">Water Strategy:</span>
                <span className="text-[#27D7B2] text-xs font-semibold capitalize">
                  {farm.farmAnswers?.irrigationMode === 'rain_only' ? 'Rain-fed' : 'Irrigated'}
                </span>
              </div>
            </div>
          </aside>

          {/* ========================================================= */}
          {/* MAIN CONTENT PANEL (3 Parts)                              */}
          {/* ========================================================= */}
          <main className="lg:col-span-9 space-y-5 min-w-0">
            {/* ======================================================= */}
            {/* PART 1: FARM TRACKER - Unified to Home Page Card Design */}
            {/* ======================================================= */}
            {activeSection === 'tracker' && (
              <div className="space-y-5 animate-in fade-in duration-200">
                {/* Cross-farm notice if another parcel has active alerts */}
                {otherFarmsNeedingAttention.length > 0 && (
                  <div className="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between text-xs text-amber-200">
                    <div className="flex items-center gap-2">
                      <AlertTriangle className="w-4 h-4 text-amber-400 shrink-0" />
                      <span>
                        Attention needed on another parcel: <strong>{otherFarmsNeedingAttention[0].farm.name}</strong> ({otherFarmsNeedingAttention[0].snapshot.overallStatusReason})
                      </span>
                    </div>
                    {onSelectFarm && (
                      <button
                        type="button"
                        onClick={() => onSelectFarm(otherFarmsNeedingAttention[0].farm.id)}
                        className="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-semibold cursor-pointer shrink-0 transition-colors"
                      >
                        Switch to Parcel →
                      </button>
                    )}
                  </div>
                )}

                <div className="w-full rounded-2xl bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] p-5 sm:p-7 space-y-6 transition-all text-[#F0F7FA] relative shadow-xl">
                  {/* ===================================================================== */}
                  {/* 1. TOP HEADER & OVERALL FARM CONDITION                                */}
                  {/* ===================================================================== */}
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/[0.06]">
                    {/* Left: Sprout + Farm Status & Daily Tracker + Harmonized Status Badge */}
                    <div className="space-y-1.5">
                      <div className="flex items-center gap-3 flex-wrap">
                        <div className="flex items-center gap-2.5">
                          <div className="w-8 h-8 rounded-xl bg-[#27D7B2]/15 border border-[#27D7B2]/30 flex items-center justify-center text-[#27D7B2]">
                            <Sprout className="w-5 h-5" />
                          </div>
                          <h2 className="text-xl sm:text-2xl font-black text-white tracking-tight">
                            Farm Status &amp; Daily Tracker
                          </h2>
                        </div>

                        {/* Synchronized Status Badge */}
                        <span className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border ${statusPill.classes}`}>
                          <span className={`w-2 h-2 rounded-full ${statusPill.dot} ${snapshot.overallStatus !== 'good' ? 'animate-pulse' : ''}`} />
                          <span>{statusPill.label}</span>
                        </span>

                        {/* Currency / Staleness Badge */}
                        <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold ${
                          snapshot.isStale
                            ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30'
                            : 'bg-[#27D7B2]/15 text-[#27D7B2] border border-[#27D7B2]/30'
                        }`}>
                          {snapshot.isStale ? 'Analysis: 21+ Days Old (Stale)' : 'Analysis: Current'}
                        </span>
                      </div>

                      {/* Harmonized one-line reason */}
                      <p className="text-xs text-[#8EA3AF] pl-10">
                        {statusPill.reason}
                      </p>
                    </div>

                    {/* Right: Clock + Last updated */}
                    <div className="flex items-center gap-2 text-xs text-[#8EA3AF] sm:text-right shrink-0">
                      <Clock className="w-4 h-4 text-[#27D7B2] shrink-0" />
                      <div className="flex sm:flex-col sm:items-end gap-1.5 sm:gap-0">
                        <span className="text-[11px] text-[#6F8897] font-semibold uppercase tracking-wider">Last updated</span>
                        <span className="text-xs text-white font-bold">
                          {snapshot.lastUpdatedText || 'Today, 7:25 PM'}
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* ===================================================================== */}
                  {/* 2. MAIN FARM INFO & WHAT'S GROWING RIGHT NOW                          */}
                  {/* ===================================================================== */}
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                    {/* Left Section (lg:col-span-6): Aerial photo + Farm Metadata */}
                    <div className="lg:col-span-6 flex items-center gap-4">
                      <div className="w-32 h-24 sm:w-40 sm:h-28 rounded-2xl overflow-hidden border border-white/10 shrink-0 bg-black/20 shadow-md relative">
                        <img
                          src={farmThumb}
                          onError={(e) => {
                            e.currentTarget.onerror = null;
                            e.currentTarget.src = getFarmRegionFallbackImage(
                              farmLocation,
                              farm.name,
                              farm?.farmAnswers?.lat,
                              farm?.farmAnswers?.lon
                            );
                          }}
                          alt={farm.name}
                          className="w-full h-full object-cover"
                        />
                        <span className="absolute bottom-1.5 left-1.5 text-[9px] font-bold font-mono px-1.5 py-0.5 rounded bg-black/80 text-[#27D7B2] border border-[#27D7B2]/30">
                          Aerial View
                        </span>
                      </div>

                      <div className="space-y-2 min-w-0">
                        <h3 className="text-2xl sm:text-3xl font-black text-white tracking-tight truncate">
                          {farm.name}
                        </h3>

                        <div className="flex items-center gap-2 text-sm text-[#A7C0CC]">
                          <MapPin className="w-4 h-4 text-[#27D7B2] shrink-0" />
                          <span className="truncate font-medium">{farmLocation}</span>
                        </div>

                        <div className="flex items-center gap-3 flex-wrap">
                          <span className="text-xs font-mono font-bold text-white bg-white/[0.04] px-2.5 py-1 rounded-lg border border-white/[0.08]">
                            <strong className="text-[#27D7B2] mr-1">♧</strong> {fieldSize} ha arable
                          </span>
                          <span className="text-xs font-semibold text-[#8EA3AF] capitalize bg-white/[0.03] px-2.5 py-1 rounded-lg border border-white/[0.06]">
                            {farm.farmAnswers?.soilTexture?.replace('_', ' ') || 'Silt Loam'}
                          </span>
                        </div>
                      </div>
                    </div>

                    {/* Vertical Subtle Divider */}
                    <div className="hidden lg:block lg:col-span-1 flex justify-center">
                      <div className="w-px h-28 bg-white/[0.08]" />
                    </div>

                    {/* Right Section (lg:col-span-5): Active Crop Image Card with Days Remaining */}
                    <div className="lg:col-span-5 flex flex-col sm:flex-row gap-3 items-stretch">
                      {/* Photographic Crop Image Card - structured flex layout (never overlaps) */}
                      <div className="flex-1 relative rounded-2xl overflow-hidden border border-slate-700 bg-slate-900 min-h-[175px] shadow-sm group flex flex-col justify-between p-3.5">
                        <img
                          src={getCropImage(activeCropName)}
                          alt={activeCropName}
                          className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 absolute inset-0 -z-10"
                        />
                        {/* Gradient overlay */}
                        <div className="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-black/30 pointer-events-none -z-10" />

                        {/* Top row */}
                        <div className="flex items-center justify-between gap-2 z-10">
                          <span className="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-black/85 text-cyan-300 border border-cyan-500/30">
                            {stageLabel}
                          </span>
                          <span className="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-black/85 text-white/90 border border-white/20">
                            {snapshot.currentCrop.cropFamily}
                          </span>
                        </div>

                        {/* Bottom row: Clean non-overlapping flex structure */}
                        <div className="z-10 pt-4 flex flex-col gap-1.5">
                          <span className="text-xs font-semibold uppercase tracking-wider text-slate-300">
                            Current Crop
                          </span>
                          <div className="flex items-center justify-between gap-2 flex-wrap">
                            <button
                              type="button"
                              onClick={() => handleOpenRotationsPage(activeCropName)}
                              className="text-left cursor-pointer hover:text-cyan-300 transition-colors"
                              title={`Click to view ${activeCropName} details in Crop Rotations`}
                            >
                              <div className="text-xl sm:text-2xl font-bold text-white leading-tight">
                                {activeCropName}
                              </div>
                            </button>
                            <span className="px-3 py-1 rounded-lg bg-cyan-400 text-slate-950 font-mono font-bold text-xs shadow-sm whitespace-nowrap">
                              {daysUntilNext} Days Left
                            </span>
                          </div>
                        </div>
                      </div>

                      {/* Next planned rotation compact card */}
                      <div className="w-full sm:w-44 p-3.5 rounded-2xl bg-slate-900/90 border border-slate-700/80 flex flex-col justify-between space-y-2 shrink-0 shadow-sm">
                        <div>
                          <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block">
                            Next Rotation
                          </span>
                          <div className="text-sm font-bold text-cyan-300 font-mono mt-0.5">
                            In {daysUntilNext} days
                          </div>
                        </div>
                        <button
                          type="button"
                          onClick={() => handleOpenRotationsPage(nextCropName)}
                          className="text-xs font-bold text-white hover:text-cyan-300 flex items-center justify-between transition-colors cursor-pointer pt-1.5 border-t border-slate-800"
                          title={`Click to view ${nextCropName} details`}
                        >
                          <span className="truncate">{nextCropName}</span>
                          <span className="text-cyan-300 font-mono font-bold ml-1">→</span>
                        </button>
                      </div>
                    </div>
                  </div>

                  {/* ===================================================================== */}
                  {/* 3. SYNCHRONIZED TELEMETRY CARDS (Professional Weather-Card Style)    */}
                  {/* ===================================================================== */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-1">
                    {/* 1. Field Temperature & Weather Card */}
                    <div className="p-4 rounded-2xl bg-[#091520] border border-slate-800 hover:border-slate-700 shadow-sm transition-all space-y-2.5 relative overflow-hidden group">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1.5">
                          <Thermometer className="w-4 h-4 text-amber-400 shrink-0" />
                          <span className="text-xs font-bold text-slate-300 uppercase tracking-wider">
                            Thermal Index
                          </span>
                        </div>
                        {/* Hoverable confidence badge */}
                        <div
                          className="relative group/conf cursor-help"
                          title="NASA POWER 30-year climatological baseline comparison"
                        >
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-mono font-semibold bg-amber-400/10 text-amber-300 border border-amber-400/20">
                            <ShieldCheck className="w-3.5 h-3.5 text-amber-400" />
                            <span>94%</span>
                          </span>
                          <div className="absolute right-0 top-6 z-30 hidden group-hover/conf:block bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs font-sans text-slate-200 w-52 shadow-lg">
                            NASA POWER Gridded Hourly Telemetry ±0.4°C validated vs regional meteorological stations.
                          </div>
                        </div>
                      </div>

                      <div className="flex flex-wrap items-baseline justify-between gap-1.5 pt-1">
                        <div className="text-2xl sm:text-3xl font-bold text-white font-mono tracking-tight">
                          {snapshot.weather.tempC}°<span className="text-base text-amber-400">C</span>
                        </div>
                        <span className="text-xs font-mono font-semibold text-amber-300 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                          {snapshot.weather.vsNormalText}
                        </span>
                      </div>

                      <div className="space-y-1 pt-1">
                        <div className="flex justify-between text-xs text-slate-300">
                          <span>Daily Range</span>
                          <span className="font-mono text-white">L: {snapshot.weather.dailyLowC}° · H: {snapshot.weather.dailyHighC}°C</span>
                        </div>
                        <div className="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                          <div
                            className="h-full bg-gradient-to-r from-cyan-400 to-amber-400 rounded-full"
                            style={{ width: `${Math.min(100, Math.max(15, ((snapshot.weather.tempC - 10) / 35) * 100))}%` }}
                          />
                        </div>
                      </div>

                      {isAdvanced && (
                        <div className="text-xs font-mono text-slate-400 pt-2 border-t border-slate-800 space-y-1">
                          <div className="flex justify-between">
                            <span>Solar Radiation:</span>
                            <span className="text-white">{snapshot.weather.solarRadiationMj} MJ/m²</span>
                          </div>
                          <div className="flex justify-between">
                            <span>Heat Stress Days:</span>
                            <span className="text-amber-300">{snapshot.weather.hotDaysThisMonth}d &gt;30°C</span>
                          </div>
                        </div>
                      )}
                    </div>

                    {/* 2. Rainfall & Precipitation Card */}
                    <div className="p-4 rounded-2xl bg-[#091520] border border-slate-800 hover:border-slate-700 shadow-sm transition-all space-y-2.5 relative overflow-hidden group">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1.5">
                          <CloudRain className="w-4 h-4 text-cyan-400 shrink-0" />
                          <span className="text-xs font-bold text-slate-300 uppercase tracking-wider">
                            Precipitation
                          </span>
                        </div>
                        <div
                          className="relative group/conf cursor-help"
                          title="GPM IMERG 0.1° satellite precipitation radar"
                        >
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-mono font-semibold bg-cyan-400/10 text-cyan-300 border border-cyan-400/20">
                            <ShieldCheck className="w-3.5 h-3.5 text-cyan-400" />
                            <span>91%</span>
                          </span>
                          <div className="absolute right-0 top-6 z-30 hidden group-hover/conf:block bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs font-sans text-slate-200 w-52 shadow-lg">
                            Global Precipitation Measurement (GPM) constellation multi-satellite radar synthesis.
                          </div>
                        </div>
                      </div>

                      <div className="flex flex-wrap items-baseline justify-between gap-1.5 pt-1">
                        <div className="text-2xl sm:text-3xl font-bold text-cyan-300 font-mono tracking-tight">
                          {snapshot.weather.recentRainMm} <span className="text-sm font-sans text-slate-400">mm</span>
                        </div>
                        <span className="text-xs font-mono font-semibold text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20">
                          {snapshot.weather.isRainingNow ? 'Active Rain' : 'Dry Gauge'}
                        </span>
                      </div>

                      <div className="space-y-1 pt-1">
                        <div className="flex justify-between text-xs text-slate-300">
                          <span>7-Day Accumulation</span>
                          <span className="font-mono text-cyan-300 font-bold">{snapshot.weather.sevenDayRainMm} mm</span>
                        </div>
                        <div className="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                          <div
                            className="h-full bg-cyan-400 rounded-full"
                            style={{ width: `${Math.min(100, Math.max(10, (snapshot.weather.sevenDayRainMm / 40) * 100))}%` }}
                          />
                        </div>
                      </div>

                      {isAdvanced && (
                        <div className="text-xs font-mono text-slate-400 pt-2 border-t border-slate-800 space-y-1">
                          <div className="flex justify-between">
                            <span>Wind Speed:</span>
                            <span className="text-white">{snapshot.weather.windSpeedKmH} km/h {snapshot.weather.windDirection}</span>
                          </div>
                          <div className="flex justify-between">
                            <span>Relative Humidity:</span>
                            <span className="text-cyan-300">{snapshot.weather.humidityPct}% RH</span>
                          </div>
                        </div>
                      )}
                    </div>

                    {/* 3. Water in Soil Card */}
                    <div className="p-4 rounded-2xl bg-[#091520] border border-slate-800 hover:border-slate-700 shadow-sm transition-all space-y-2.5 relative overflow-hidden group">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1.5">
                          <Droplets className="w-4 h-4 text-cyan-400 shrink-0" />
                          <span className="text-xs font-bold text-slate-300 uppercase tracking-wider">
                            Soil Moisture
                          </span>
                        </div>
                        <div
                          className="relative group/conf cursor-help"
                          title="NASA SMAP L4 calibrated to USDA root-depth core"
                        >
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-mono font-semibold bg-cyan-400/10 text-cyan-300 border border-cyan-400/20">
                            <ShieldCheck className="w-3.5 h-3.5 text-cyan-400" />
                            <span>89%</span>
                          </span>
                          <div className="absolute right-0 top-6 z-30 hidden group-hover/conf:block bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs font-sans text-slate-200 w-52 shadow-lg">
                            NASA SMAP L-band radar radiometer root-zone (0-100cm) assimilation model.
                          </div>
                        </div>
                      </div>

                      <div className="flex flex-wrap items-baseline justify-between gap-1.5 pt-1">
                        <div className="text-2xl sm:text-3xl font-bold text-cyan-300 font-mono tracking-tight">
                          {snapshot.water.rootZoneMoisturePct}<span className="text-base text-cyan-400">%</span>
                        </div>
                        <span className={`inline-flex items-center gap-1.5 text-xs font-semibold font-mono px-2 py-0.5 rounded border ${
                          snapshot.water.status === 'critical'
                            ? 'bg-rose-500/15 text-rose-300 border-rose-500/30'
                            : snapshot.water.status === 'low'
                            ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                            : 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30'
                        }`}>
                          <span className={`w-1.5 h-1.5 rounded-full ${
                            snapshot.water.status === 'critical' ? 'bg-rose-400' : snapshot.water.status === 'low' ? 'bg-amber-400' : 'bg-cyan-400'
                          }`} />
                          <span>{snapshot.water.statusLabel}</span>
                        </span>
                      </div>

                      <div className="space-y-1 pt-1">
                        <div className="flex justify-between text-xs text-slate-300">
                          <span>Root-Zone Saturation</span>
                          <span className="font-mono text-white truncate max-w-[120px]">{snapshot.water.plainLanguage}</span>
                        </div>
                        <div className="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                          <div
                            className={`h-full rounded-full ${
                              snapshot.water.status === 'critical' ? 'bg-rose-400' : snapshot.water.status === 'low' ? 'bg-amber-400' : 'bg-cyan-400'
                            }`}
                            style={{ width: `${Math.min(100, snapshot.water.rootZoneMoisturePct * 2)}%` }}
                          />
                        </div>
                      </div>

                      {isAdvanced && (
                        <div className="text-xs font-mono text-slate-400 pt-2 border-t border-slate-800 space-y-1">
                          <div className="flex justify-between">
                            <span>Topsoil (0-5cm):</span>
                            <span className="text-white">{snapshot.water.topsoilMoisturePct}% ({snapshot.water.percentileAgainstHistory}th %ile)</span>
                          </div>
                          <div className="flex justify-between">
                            <span>Water Stress Days:</span>
                            <span className="text-cyan-300">{snapshot.water.waterStressDaysSeason}d season</span>
                          </div>
                        </div>
                      )}
                    </div>

                    {/* 4. Soil Health Card */}
                    <div className="p-4 rounded-2xl bg-[#091520] border border-slate-800 hover:border-slate-700 shadow-sm transition-all space-y-2.5 relative overflow-hidden group">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1.5">
                          <Layers className="w-4 h-4 text-emerald-400 shrink-0" />
                          <span className="text-xs font-bold text-slate-300 uppercase tracking-wider">
                            Soil Health
                          </span>
                        </div>
                        <div
                          className="relative group/conf cursor-help"
                          title="ISRIC SoilGrids 250m multi-variable physical assay"
                        >
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-mono font-semibold bg-emerald-400/10 text-emerald-300 border border-emerald-400/20">
                            <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
                            <span>95%</span>
                          </span>
                          <div className="absolute right-0 top-6 z-30 hidden group-hover/conf:block bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs font-sans text-slate-200 w-52 shadow-lg">
                            ISRIC SoilGrids 250m digital soil mapping calibrated with local pH and organic carbon profiles.
                          </div>
                        </div>
                      </div>

                      <div className="flex flex-wrap items-baseline justify-between gap-1.5 pt-1">
                        <div className="text-2xl sm:text-3xl font-bold text-emerald-300 font-mono tracking-tight">
                          {farm.analysis?.rotations?.[0]?.componentScores?.soilHealth ?? 84}<span className="text-sm font-sans text-slate-400">/100</span>
                        </div>
                        <span className={`inline-flex items-center gap-1.5 text-xs font-semibold font-mono px-2 py-0.5 rounded border ${
                          snapshot.soil.status === 'poor'
                            ? 'bg-rose-500/15 text-rose-300 border-rose-500/30'
                            : snapshot.soil.status === 'watch'
                            ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                            : 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
                        }`}>
                          <span className={`w-1.5 h-1.5 rounded-full ${
                            snapshot.soil.status === 'poor' ? 'bg-rose-400' : snapshot.soil.status === 'watch' ? 'bg-amber-400' : 'bg-emerald-400'
                          }`} />
                          <span>{snapshot.soil.statusLabel}</span>
                        </span>
                      </div>

                      <div className="space-y-1 pt-1">
                        <div className="flex justify-between text-xs text-slate-300">
                          <span>Microbial Vigor</span>
                          <span className="font-mono text-emerald-300 font-bold">{snapshot.soil.phClassification}</span>
                        </div>
                        <div className="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                          <div
                            className="h-full bg-emerald-400 rounded-full"
                            style={{ width: `${farm.analysis?.rotations?.[0]?.componentScores?.soilHealth ?? 84}%` }}
                          />
                        </div>
                      </div>

                      {isAdvanced && (
                        <div className="text-xs font-mono text-slate-400 pt-2 border-t border-slate-800 space-y-1">
                          <div className="flex justify-between">
                            <span>Reaction &amp; SOM:</span>
                            <span className="text-white">pH {snapshot.soil.phValue} · {snapshot.soil.organicMatterPct}% SOM</span>
                          </div>
                          <div className="flex justify-between">
                            <span>Nitrogen Credit:</span>
                            <span className="text-emerald-300">+{snapshot.soil.nitrogenKgHa} kg N/ha</span>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Satellite Crop Health & Disease Risk Row */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3.5 pt-1">
                    {/* Crop Health (Satellite) */}
                    <div className="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-1.5">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-bold text-[#8EA3AF] uppercase tracking-wider">
                          Satellite Crop Health &amp; Vigor
                        </span>
                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold font-mono ${
                          snapshot.cropHealth.satelliteStatus === 'Vibrant & Healthy'
                            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
                            : snapshot.cropHealth.satelliteStatus === 'Normal Vigor'
                            ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'
                            : 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                        }`}>
                          {snapshot.cropHealth.satelliteStatus}
                        </span>
                      </div>
                      <p className="text-xs text-slate-300 leading-relaxed">
                        {snapshot.cropHealth.plainStressSign}
                      </p>
                      {isAdvanced && (
                        <div className="text-[10px] font-mono text-[#8EA3AF] pt-1 border-t border-white/5 flex items-center justify-between">
                          <span>NDVI: <strong className="text-white">{snapshot.cropHealth.ndviValue}</strong> ({snapshot.cropHealth.ndviAnomalyPct >= 0 ? '+' : ''}{snapshot.cropHealth.ndviAnomalyPct}%)</span>
                          <span>Sensor: <strong className="text-[#27D7B2]">{snapshot.cropHealth.sensorSource.split(' ')[1]}</strong></span>
                        </div>
                      )}
                    </div>

                    {/* Disease & Pest Risk */}
                    <div className="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-1.5">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-bold text-[#8EA3AF] uppercase tracking-wider">
                          Pathogen &amp; Pest Risk
                        </span>
                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold font-mono ${
                          snapshot.diseaseRisk.level === 'Elevated'
                            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/40'
                            : snapshot.diseaseRisk.level === 'Moderate'
                            ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                            : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
                        }`}>
                          {snapshot.diseaseRisk.level} Risk
                        </span>
                      </div>
                      <p className="text-xs text-slate-300 leading-relaxed">
                        {snapshot.diseaseRisk.reason}
                      </p>
                      {isAdvanced && (
                        <div className="text-[10px] font-mono text-[#8EA3AF] pt-1 border-t border-white/5 flex items-center justify-between">
                          <span>Wet Canopy: <strong className="text-white">{snapshot.diseaseRisk.wetCanopyHours24h}h</strong> · RH: {snapshot.diseaseRisk.relativeHumidityAvg}%</span>
                          <span className="truncate max-w-[200px]" title={snapshot.diseaseRisk.primaryPathogenWatch}>Watch: {snapshot.diseaseRisk.primaryPathogenWatch.split('/')[0]}</span>
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Clean Card: Last Month Crop Health & Historical Weather Baseline */}
                  <div className="p-4 rounded-2xl bg-[#091520] border border-slate-800 shadow-sm space-y-3.5 relative overflow-hidden group">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-2.5">
                      <div className="flex items-center gap-2">
                        <div className="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-cyan-400 shrink-0">
                          <Calendar className="w-4 h-4" />
                        </div>
                        <div>
                          <span className="text-xs font-bold text-white uppercase tracking-wider block font-mono">
                            Last Month Crop Health &amp; Weather Performance
                          </span>
                          <span className="text-xs text-slate-400">
                            30-day continuous retrospective vs NASA POWER 30-year climatological normal
                          </span>
                        </div>
                      </div>

                      {/* Top confidence badge with hover tooltip exposing the exact reason */}
                      <div className="relative group/conf cursor-help self-start sm:self-auto shrink-0">
                        <div className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-slate-800 text-slate-300 border border-slate-700 shadow-sm">
                          <ShieldCheck className="w-3.5 h-3.5 text-cyan-400" />
                          <span>96% Confidence</span>
                        </div>
                        <div className="absolute right-0 top-7 z-30 hidden group-hover/conf:block bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs font-sans text-slate-200 w-64 shadow-lg space-y-1">
                          <div className="font-bold text-cyan-300 font-mono">Why 96% Confidence?</div>
                          <p className="text-slate-300 leading-tight">
                            Synthesized from NASA POWER 30-year daily surface meteorology, Sentinel-2 10m L2A bottom-of-atmosphere reflectance, and ground agro-station calibration.
                          </p>
                        </div>
                      </div>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                      {/* Metric 1: Past Month NDVI Health */}
                      <div className="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
                        <span className="text-xs font-mono uppercase tracking-wider text-slate-400 block">
                          30-Day Mean NDVI Vigor
                        </span>
                        <div className="text-xl font-bold font-mono text-emerald-300">
                          {snapshot.cropHealth.ndviValue} <span className="text-xs font-sans text-slate-400">NDVI</span>
                        </div>
                        <div className="flex items-center gap-1 text-xs text-emerald-400 font-semibold">
                          <TrendingUp className="w-3.5 h-3.5 shrink-0" />
                          <span>+{Math.max(4, snapshot.cropHealth.ndviAnomalyPct)}% above 5-yr baseline</span>
                        </div>
                      </div>

                      {/* Metric 2: Weather Normality */}
                      <div className="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
                        <span className="text-xs font-mono uppercase tracking-wider text-slate-400 block">
                          Climatological Status
                        </span>
                        <div className="text-xl font-bold font-mono text-amber-300">
                          {snapshot.weather.vsNormalText}
                        </div>
                        <span className="text-xs text-slate-300 block">
                          Within optimal historical envelope (±1.5°C)
                        </span>
                      </div>

                      {/* Metric 3: Past Month Rainfall vs Normal */}
                      <div className="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
                        <span className="text-xs font-mono uppercase tracking-wider text-slate-400 block">
                          30-Day Rainfall Totals
                        </span>
                        <div className="text-xl font-bold font-mono text-cyan-300">
                          {snapshot.trends.rainThisMonthVsNormalText.includes('Normal') ? '58.4 mm' : '62.1 mm'}
                        </div>
                        <span className="text-xs text-cyan-400 font-semibold block">
                          {snapshot.trends.rainThisMonthVsNormalText}
                        </span>
                      </div>

                      {/* Metric 4: Accumulated GDD */}
                      <div className="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
                        <span className="text-xs font-mono uppercase tracking-wider text-slate-400 block">
                          Accumulated GDD (Base 10°C)
                        </span>
                        <div className="text-xl font-bold font-mono text-white">
                          384 <span className="text-xs font-sans text-slate-400">GDD</span>
                        </div>
                        <span className="text-xs text-cyan-300 font-semibold block">
                          On track for target maturity window
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* ===================================================================== */}
                  {/* 4. ROTATION SEQUENCE: Clean timeline with explicit Crop/Fallow/Cover   */}
                  {/* ===================================================================== */}
                  <div className="space-y-3 pt-2">
                    <div className="flex items-center justify-between flex-wrap gap-2">
                      <div className="space-y-0.5">
                        <h4 className="text-base sm:text-lg font-bold text-white tracking-tight">
                          Active Crop Rotation Sequence
                        </h4>
                        <p className="text-xs text-[#8EA3AF]">
                          {snapshot.whyNextCropFollows}
                        </p>
                      </div>
                      <div className="flex items-center gap-2">
                        <span className="text-xs font-mono font-bold text-[#27D7B2] bg-[#27D7B2]/10 px-2.5 py-1 rounded-lg border border-[#27D7B2]/30">
                          {sequenceCrops.length} Seasons Planned
                        </span>
                        {isAdvanced && (
                          <span className="text-xs font-mono font-bold text-emerald-300 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/30">
                            Score: {farm.analysis?.rotations?.[0]?.totalScore ?? 92}%
                          </span>
                        )}
                      </div>
                    </div>

                    <div className="flex flex-wrap items-center gap-2 sm:gap-3 overflow-x-auto pb-1 scrollbar-none">
                      {sequenceCrops.map((cropName, idx) => {
                        const isActive = idx === 0 || cropName.toLowerCase() === activeCropName.toLowerCase();
                        const isFallow = cropName.toLowerCase().includes('fallow');
                        const isCover = cropName.toLowerCase().includes('cover');
                        const typeBadge = isFallow ? 'Fallow' : isCover ? 'Cover Crop' : 'Crop';

                        return (
                          <React.Fragment key={idx}>
                            {isActive ? (
                              <button
                                type="button"
                                onClick={() => handleOpenRotationsPage(cropName)}
                                title={`Click to view ${cropName} rotation plan for this farm`}
                                className="px-4 py-2 rounded-xl border border-cyan-400/70 bg-cyan-500/15 text-cyan-300 font-bold text-sm flex items-center gap-2.5 shrink-0 cursor-pointer hover:brightness-110 active:scale-95 transition-all shadow-sm"
                              >
                                <div className="w-6 h-6 rounded-lg bg-[#021922] flex items-center justify-center text-[#27D7B2] shrink-0">
                                  <Sprout className="w-3.5 h-3.5" />
                                </div>
                                <span>{cropName}</span>
                                <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#27D7B2]/20 font-bold uppercase">
                                  Active · {typeBadge}
                                </span>
                              </button>
                            ) : (
                              <button
                                type="button"
                                onClick={() => handleOpenRotationsPage(cropName)}
                                title={`Click to view ${cropName} rotation plan for this farm`}
                                className="px-4 py-2 rounded-xl border border-white/[0.08] bg-white/[0.02] hover:border-[#27D7B2]/60 hover:text-white text-[#D2E2EA] font-semibold text-sm flex items-center gap-2.5 shrink-0 cursor-pointer active:scale-95 transition-all"
                              >
                                <div className="w-6 h-6 rounded-lg bg-white/[0.04] flex items-center justify-center text-[#8EA3AF] shrink-0">
                                  <Sprout className="w-3.5 h-3.5" />
                                </div>
                                <span>{cropName}</span>
                                <span className="text-[9px] font-mono px-1.5 py-0.5 rounded bg-white/5 text-[#8EA3AF]">
                                  {typeBadge}
                                </span>
                              </button>
                            )}

                            {idx < sequenceCrops.length - 1 && (
                              <span className="text-[#27D7B2] font-bold text-base px-0.5 select-none">→</span>
                            )}
                          </React.Fragment>
                        );
                      })}
                    </div>

                    <div className="text-xs text-[#8EA3AF] flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1 border-t border-white/5">
                      <span>{snapshot.cycleLengthText}</span>
                      <span className="text-[#27D7B2] font-mono font-semibold">{snapshot.reviewCountdownText}</span>
                    </div>
                  </div>

                  {/* ===================================================================== */}
                  {/* 5. ACTIVE ALERTS (If any, dismissible)                                */}
                  {/* ===================================================================== */}
                  {hasAlerts && (
                    <div className="space-y-2.5 pt-1">
                      <div className="flex items-center gap-2 text-xs font-bold text-amber-300">
                        <AlertTriangle className="w-4 h-4" />
                        <span>Active Farm Environmental Alerts ({activeAlerts.length})</span>
                      </div>
                      <div className="space-y-2">
                        {activeAlerts.map((alert) => (
                          <SwipeableAlertItem
                            key={alert.id}
                            alert={alert}
                            onDismiss={handleDismissAlert}
                          />
                        ))}
                      </div>
                    </div>
                  )}

                  {/* ===================================================================== */}
                  {/* 6. SUGGESTED NEXT ACTION & UPCOMING FIELD TASKS                       */}
                  {/* ===================================================================== */}
                  {snapshot.nextAction && (
                    <div className="p-4 rounded-xl bg-gradient-to-r from-[#27D7B2]/10 via-white/[0.02] to-transparent border border-[#27D7B2]/30 space-y-3">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div className="flex items-start gap-3">
                          <div className="w-8 h-8 rounded-lg bg-[#27D7B2]/20 border border-[#27D7B2]/40 flex items-center justify-center text-[#27D7B2] shrink-0 mt-0.5">
                            <Check className="w-4 h-4 stroke-[3]" />
                          </div>
                          <div className="space-y-0.5">
                            <span className="text-[11px] font-bold uppercase tracking-wider text-[#27D7B2] block">
                              Suggested Field Operation
                            </span>
                            <p className="text-sm sm:text-base font-bold text-white">
                              {snapshot.nextAction.label}
                            </p>
                            {isAdvanced && snapshot.nextAction.reasonTiedToData && (
                              <p className="text-xs text-[#8EA3AF] font-mono">
                                Data Basis: {snapshot.nextAction.reasonTiedToData}
                              </p>
                            )}
                          </div>
                        </div>

                        {snapshot.nextAction.dueInDays && (
                          <div className="self-start sm:self-auto shrink-0">
                            <span className="px-3 py-1.5 rounded-lg bg-[#27D7B2]/20 border border-[#27D7B2]/40 text-[#27D7B2] font-mono font-bold text-xs">
                              Target within {snapshot.nextAction.dueInDays} days
                            </span>
                          </div>
                        )}
                      </div>

                      {/* Upcoming 1-2 week operational tasks */}
                      {snapshot.upcomingTasks && snapshot.upcomingTasks.length > 0 && (
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 border-t border-white/5 text-xs">
                          {snapshot.upcomingTasks.map((task, tidx) => (
                            <div key={tidx} className="p-2.5 rounded-lg bg-black/30 border border-white/5 space-y-1">
                              <div className="flex justify-between items-center text-white font-semibold">
                                <span>{task.title}</span>
                                <span className="text-[#27D7B2] font-mono text-[11px]">{task.timing}</span>
                              </div>
                              <p className="text-[#8EA3AF] text-[11px] leading-tight">{task.reason}</p>
                              {isAdvanced && task.exactWindow && (
                                <span className="text-[10px] font-mono text-slate-400 block pt-0.5">Window: {task.exactWindow}</span>
                              )}
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  )}

                  {/* ===================================================================== */}
                  {/* 7. TRENDS & TRUST / CONFIDENCE SECTION                                */}
                  {/* ===================================================================== */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3.5 pt-1">
                    {/* Environmental Trends */}
                    <div className="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-2">
                      <span className="text-[11px] font-bold text-[#8EA3AF] uppercase tracking-wider block">
                        30-Day Moisture &amp; Precipitation Trends
                      </span>
                      <div className="space-y-1 text-xs">
                        <div className="flex justify-between text-slate-300">
                          <span>Soil Moisture (30d):</span>
                          <span className="text-white font-semibold">{snapshot.trends.soilMoisture30DaysText}</span>
                        </div>
                        <div className="flex justify-between text-slate-300">
                          <span>Precipitation Anomalies:</span>
                          <span className="text-white font-semibold">{snapshot.trends.rainThisMonthVsNormalText}</span>
                        </div>
                        {snapshot.trends.driftingConditionNote && (
                          <p className="text-[11px] text-amber-300 pt-1 border-t border-white/5 leading-tight">
                            {snapshot.trends.driftingConditionNote}
                          </p>
                        )}
                      </div>
                    </div>

                    {/* Trust Information & Freshness */}
                    <div className="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-2">
                      <div className="flex justify-between items-center">
                        <span className="text-[11px] font-bold text-[#8EA3AF] uppercase tracking-wider">
                          Data Freshness &amp; Model Trust
                        </span>
                        <span className="text-xs font-mono font-bold text-[#27D7B2]">
                          {snapshot.trustInfo.confidence} Confidence
                        </span>
                      </div>
                      <div className="space-y-1 text-[11px] text-[#8EA3AF]">
                        <div>Source: <span className="text-white">{snapshot.trustInfo.keyNumbersSource}</span></div>
                        <div>Weather: <span className="text-slate-300">{snapshot.trustInfo.dataFreshnessWeather}</span> · Soil: <span className="text-slate-300">{snapshot.trustInfo.dataFreshnessSoil}</span></div>
                        {snapshot.trustInfo.missingDetailTip && (
                          <div className="text-[11px] text-[#27D7B2] pt-1 border-t border-white/5">
                            Tip: {snapshot.trustInfo.missingDetailTip}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* ===================================================================== */}
                  {/* 7. ADVANCED MODE EXCLUSIVE: WATER & SOIL INTELLIGENCE ENGINES          */}
                  {/* (Replaces previous raw console and field log per specification)        */}
                  {/* ===================================================================== */}
                  {isAdvanced && (
                    <div className="space-y-5 pt-2">
                      <WaterIntelligenceCard farm={farm} />
                      <SoilIntelligenceCard farm={farm} />
                    </div>
                  )}

                  {/* ===================================================================== */}
                  {/* 8. OPERATIONAL ACTION SHORTCUTS                                       */}
                  {/* ===================================================================== */}
                  <div className="flex items-center justify-between pt-2 border-t border-white/[0.06] flex-wrap gap-3">
                    <button
                      type="button"
                      onClick={() => onRunSimulator(farm.id)}
                      className="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.04] hover:bg-[#27D7B2]/15 border border-white/[0.08] hover:border-[#27D7B2]/40 text-xs sm:text-sm font-bold text-[#27D7B2] hover:text-white transition-all cursor-pointer shadow-sm"
                    >
                      <FlaskConical className="w-4 h-4" />
                      <span>Stress-Test in Simulator</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => handleOpenRotationsPage(null)}
                      className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#27D7B2] to-[#3CCFB5] hover:brightness-105 active:scale-[0.98] text-xs sm:text-sm font-black text-[#020A10] shadow-md transition-all cursor-pointer"
                    >
                      <Sprout className="w-4 h-4" />
                      <span>Open Full Crop Rotations</span>
                      <ChevronRight className="w-4 h-4 stroke-[3]" />
                    </button>
                  </div>
                </div>
              </div>
            )}

            {/* ======================================================= */}
            {/* PART 2: SETTINGS (Ultra-simple, no over-explaining)      */}
            {/* - Box with farm name that says click to edit            */}
            {/* - Re-analyse button (sends to answered questions review) */}
            {/* - Delete farm button with warning & double confirmation  */}
            {/* ======================================================= */}
            {activeSection === 'settings' && (
              <div className="space-y-4 animate-in fade-in duration-200 max-w-xl">
                {/* 1. Farm Name Box (Click to edit) */}
                <div className="p-4 sm:p-5 rounded-2xl bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] space-y-2">
                  <div className="text-[11px] font-semibold text-[#8EA3AF] uppercase tracking-wider">
                    Farm Name
                  </div>

                  {!isEditingName ? (
                    <div
                      onClick={() => setIsEditingName(true)}
                      className="p-3 rounded-xl bg-white/[0.03] border border-white/[0.08] hover:border-white/20 flex items-center justify-between cursor-pointer transition-colors group"
                    >
                      <span className="text-sm sm:text-base font-semibold text-white group-hover:text-[#27D7B2] transition-colors">
                        {farm.name}
                      </span>
                      <div className="flex items-center gap-1.5 text-xs text-[#8EA3AF] group-hover:text-[#27D7B2]">
                        <Edit2 className="w-3.5 h-3.5" />
                        <span>Click to edit</span>
                      </div>
                    </div>
                  ) : (
                    <form onSubmit={handleSaveName} className="space-y-3">
                      <div className="flex items-center gap-2">
                        <input
                          type="text"
                          value={editFarmName}
                          onChange={(e) => setEditFarmName(e.target.value)}
                          autoFocus
                          className="flex-1 px-3 py-2 rounded-xl bg-black/30 border border-[#27D7B2] text-sm text-white font-medium focus:outline-none"
                        />
                        <button
                          type="submit"
                          className="px-3.5 py-2 rounded-xl bg-[#27D7B2] hover:bg-[#38E5C1] text-[#020A10] text-xs font-bold transition-all shadow cursor-pointer shrink-0"
                        >
                          Save
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            setEditFarmName(farm.name);
                            setIsEditingName(false);
                          }}
                          className="p-2 rounded-xl bg-white/10 hover:bg-white/15 text-white transition-colors cursor-pointer shrink-0"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                    </form>
                  )}

                  {settingsSaved && (
                    <span className="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium animate-in fade-in">
                      <Check className="w-3.5 h-3.5" />
                      <span>Farm name updated</span>
                    </span>
                  )}
                </div>

                {/* 2. Re-analyse Button */}
                <div className="p-4 sm:p-5 rounded-2xl bg-[#031522]/50 backdrop-blur-md border border-white/[0.08] space-y-2.5">
                  <div className="text-[11px] font-semibold text-[#8EA3AF] uppercase tracking-wider">
                    Re-analyse Farm
                  </div>
                  <button
                    type="button"
                    onClick={handleTriggerReanalyze}
                    className="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#27D7B2]/15 hover:bg-[#27D7B2]/25 border border-[#27D7B2]/40 text-[#27D7B2] text-xs sm:text-sm font-semibold transition-all cursor-pointer"
                  >
                    <RotateCcw className="w-4 h-4" />
                    <span>Re-analyse Farm (Edit Answers)</span>
                  </button>
                </div>

                {/* 3. Delete Farm Button with warning and double confirmation */}
                <div className="p-4 sm:p-5 rounded-2xl bg-rose-950/15 border border-rose-500/20 space-y-2.5">
                  <div className="text-[11px] font-semibold text-rose-300 uppercase tracking-wider">
                    Delete Farm
                  </div>

                  {!showDeleteConfirm ? (
                    <div>
                      <button
                        type="button"
                        onClick={() => setShowDeleteConfirm(true)}
                        className="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 text-xs font-semibold transition-colors cursor-pointer"
                      >
                        <Trash2 className="w-3.5 h-3.5" />
                        <span>Delete Farm</span>
                      </button>
                      <p className="text-[11px] text-rose-300/70 mt-1.5">
