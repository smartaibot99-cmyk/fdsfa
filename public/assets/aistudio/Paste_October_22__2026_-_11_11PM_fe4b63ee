import {
  AnalysisPayload,
  ClimateObservation,
  ConfidenceBreakdown,
  ConfidenceLevel,
  CropInfo,
  CropSuitabilityBreakdown,
  FarmAnswers,
  NormalizedWeights,
  PrioritiesState,
  Provenance,
