    <path d="M150 -5 C200 15 190 52 239 60 C295 69 310 112 285 180"/>
    <path d="M170 -10 C220 8 210 42 260 49 C320 60 330 110 310 180"/>
    <path d="M110 0 C150 35 145 80 190 92 C225 102 240 140 220 180"/>
