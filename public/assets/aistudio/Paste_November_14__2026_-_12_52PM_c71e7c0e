16.1 Reusable glass panel class

.glass-panel {
  position: relative;
  overflow: hidden;

  background: linear-gradient(
    135deg,
    rgba(0, 39, 79, .69),
    rgba(0, 23, 54, .73),
    rgba(0, 39, 72, .69)
  );

  border: 1px solid rgba(68, 202, 255, .48);
  border-radius: 36px;

  backdrop-filter:
    blur(18px)
    saturate(140%);

  -webkit-backdrop-filter:
    blur(18px)
    saturate(140%);

  box-shadow:
    0 0 12px rgba(0, 195, 255, .23),
    0 0 30px rgba(0, 147, 255, .14),
    0 15px 45px rgba(0, 0, 0, .35),
    inset 0 1px 2px rgba(170, 241, 255, .12);
}

.glass-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;

  background: linear-gradient(
    135deg,
    rgba(255,255,255,.09),
    transparent 22%,
    transparent 75%,
    rgba(0,220,255,.04)
  );
}

.glass-panel > * {
  position: relative;
  z-index: 1;
}



