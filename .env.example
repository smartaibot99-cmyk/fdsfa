# GEMINI_API_KEY: Required for server-side Gemini AI reasoning & Ask Anchor chat.
# If omitted, Anchor runs cleanly in deterministic NASA data-only mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_API_KEY: Optional key for NASA API gateway (APOD, NeoWs, DONKI).
# Falls back to DEMO_KEY if omitted.
NASA_API_KEY="DEMO_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
